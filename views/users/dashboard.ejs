<% layout("/layouts/boilerplate") %>

<!-- 1. Header / Welcome Banner -->
<div class="row mt-4 mb-4">
  <div class="col-12">
    <div class="card border-0 shadow-sm rounded-4 dashboard-welcome-card p-4">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="dashboard-avatar-circle">
            <i class="fa-solid fa-user-circle fa-2xl text-danger"></i>
          </div>
          <div>
            <h2 class="fw-bold mb-1">
              Welcome back, <%= user.username ? user.username : "Traveler" %>! 👋
            </h2>
            <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">
              <% if (user.email) { %>
                <span><i class="fa-solid fa-envelope me-1 text-secondary"></i><%= user.email %></span>
                <span>•</span>
              <% } %>
              <span><i class="fa-solid fa-shield-halved me-1 text-success"></i>Verified Member</span>
            </div>
          </div>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/profile/edit" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill">
            <i class="fa-solid fa-user-pen me-1"></i>Edit Profile
          </a>
          <% if (user.role === "USER") { %>
            <a href="/become-host" class="wl-btn wl-btn-outline-brand wl-btn-sm wl-btn-pill">
              <i class="fa-solid fa-house-chimney-user me-1"></i>Become a Host
            </a>
          <% } else if (user.role === "HOST") { %>
            <a href="/host/dashboard" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill">
              <i class="fa-solid fa-hotel me-1"></i>Host Dashboard
            </a>
            <a href="/listings/new" class="wl-btn wl-btn-primary wl-btn-sm wl-btn-pill add-btn">
              <i class="fa-solid fa-plus me-1"></i>Add Listing
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 2. Statistics: 6 Summary Cards -->
<div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3 mb-4">
  <!-- Total Bookings -->
  <div class="col">
    <a href="#my-bookings" class="text-decoration-none text-dark">
      <div class="card h-100 border shadow-sm rounded-4 p-3 dashboard-stat-card">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">Total Bookings</span>
          <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
        </div>
        <h3 class="fw-bold mb-0"><%= counts.totalBookings %></h3>
        <span class="text-muted small" style="font-size: 0.75rem;">All reservations</span>
      </div>
    </a>
  </div>

  <!-- Upcoming Bookings -->
  <div class="col">
    <a href="#upcoming-bookings" class="text-decoration-none text-dark">
      <div class="card h-100 border shadow-sm rounded-4 p-3 dashboard-stat-card">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">Upcoming</span>
          <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success">
            <i class="fa-solid fa-clock"></i>
          </div>
        </div>
        <h3 class="fw-bold mb-0"><%= counts.upcomingBookings %></h3>
        <span class="text-muted small" style="font-size: 0.75rem;">Future trips</span>
      </div>
    </a>
  </div>

  <!-- Completed Bookings -->
  <div class="col">
    <a href="#my-bookings" class="text-decoration-none text-dark">
      <div class="card h-100 border shadow-sm rounded-4 p-3 dashboard-stat-card">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">Completed</span>
          <div class="stat-icon-wrapper bg-info bg-opacity-10 text-info">
            <i class="fa-solid fa-circle-check"></i>
          </div>
        </div>
        <h3 class="fw-bold mb-0"><%= counts.completedBookings %></h3>
        <span class="text-muted small" style="font-size: 0.75rem;">Past journeys</span>
      </div>
    </a>
  </div>

  <!-- Cancelled Bookings -->
  <div class="col">
    <a href="#my-bookings" class="text-decoration-none text-dark">
      <div class="card h-100 border shadow-sm rounded-4 p-3 dashboard-stat-card">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">Cancelled</span>
          <div class="stat-icon-wrapper bg-danger bg-opacity-10 text-danger">
            <i class="fa-solid fa-ban"></i>
          </div>
        </div>
        <h3 class="fw-bold mb-0"><%= counts.cancelledBookings %></h3>
        <span class="text-muted small" style="font-size: 0.75rem;">Cancelled stays</span>
      </div>
    </a>
  </div>

  <!-- My Listings -->
  <div class="col">
    <a href="#my-listings" class="text-decoration-none text-dark">
      <div class="card h-100 border shadow-sm rounded-4 p-3 dashboard-stat-card">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">My Listings</span>
          <div class="stat-icon-wrapper bg-secondary bg-opacity-10 text-secondary">
            <i class="fa-solid fa-house"></i>
          </div>
        </div>
        <h3 class="fw-bold mb-0"><%= counts.totalListings %></h3>
        <span class="text-muted small" style="font-size: 0.75rem;">Hosted properties</span>
      </div>
    </a>
  </div>

  <!-- Wishlist Count -->
  <div class="col">
    <a href="#wishlist-section" class="text-decoration-none text-dark">
      <div class="card h-100 border shadow-sm rounded-4 p-3 dashboard-stat-card">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span class="text-muted small fw-semibold text-uppercase" style="font-size: 0.7rem;">Wishlist</span>
          <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning">
            <i class="fa-solid fa-heart"></i>
          </div>
        </div>
        <h3 class="fw-bold mb-0"><%= counts.wishlistCount %></h3>
        <span class="text-muted small" style="font-size: 0.75rem;">Saved places</span>
      </div>
    </a>
  </div>
</div>

<!-- 3. Quick Actions Bar -->
<div class="row mb-5">
  <div class="col-12">
    <div class="card border shadow-sm rounded-4 p-3 bg-light">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span class="fw-bold small text-uppercase text-secondary">
          <i class="fa-solid fa-compass me-1 text-danger"></i>Quick Actions
        </span>
        <div class="d-flex flex-wrap gap-2">
          <a href="/listings" class="btn btn-sm btn-white bg-white border fw-medium shadow-sm">
            <i class="fa-solid fa-magnifying-glass text-primary me-1"></i>Find Listings
          </a>
          <a href="#my-bookings" class="btn btn-sm btn-white bg-white border fw-medium shadow-sm">
            <i class="fa-regular fa-calendar-check text-primary me-1"></i>My Bookings
          </a>
          <a href="#my-listings" class="btn btn-sm btn-white bg-white border fw-medium shadow-sm">
            <i class="fa-solid fa-house-user text-danger me-1"></i>My Listings
          </a>
          <a href="#wishlist-section" class="btn btn-sm btn-white bg-white border fw-medium shadow-sm">
            <i class="fa-regular fa-heart text-danger me-1"></i>Wishlist
          </a>
          <% if (user.role === "USER") { %>
            <a href="/become-host" class="btn btn-sm btn-outline-danger fw-medium shadow-sm">
              <i class="fa-solid fa-house-chimney-user me-1"></i>Become a Host
            </a>
          <% } else if (user.role === "HOST") { %>
            <a href="#my-listings" class="btn btn-sm btn-white bg-white border fw-medium shadow-sm">
              <i class="fa-solid fa-house-user text-danger me-1"></i>My Listings
            </a>
            <a href="/host/dashboard" class="btn btn-sm btn-outline-primary fw-medium shadow-sm">
              <i class="fa-solid fa-hotel me-1"></i>Host Dashboard
            </a>
            <a href="/listings/new" class="btn btn-sm btn-danger add-btn text-white fw-medium shadow-sm">
              <i class="fa-solid fa-plus me-1"></i>Add Listing
            </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- 4. UPCOMING BOOKINGS SECTION -->
<div id="upcoming-bookings" class="row mb-5">
  <div class="col-12">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-bold mb-0">
        <i class="fa-solid fa-clock text-success me-2"></i>Upcoming Stays
        <span class="badge bg-success fs-6 align-middle ms-1"><%= counts.upcomingBookings %></span>
      </h4>
      <a href="#my-bookings" class="small text-decoration-none fw-semibold text-danger">
        View All Bookings &rarr;
      </a>
    </div>

    <% if (!upcomingBookings || upcomingBookings.length === 0) { %>
      <div class="card border shadow-sm rounded-4 p-4 text-center my-2">
        <div class="py-2">
          <i class="fa-regular fa-calendar fa-2x text-muted mb-2 opacity-50"></i>
          <h6 class="fw-bold mb-1">No upcoming bookings</h6>
          <p class="text-muted small mb-3">You don't have any future trips booked yet. Time to plan your next getaway!</p>
          <a href="/listings" class="btn btn-sm btn-dark add-btn text-white px-3 py-2 fw-semibold">
            Explore Stays
          </a>
        </div>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        <% for (let booking of upcomingBookings) { %>
          <%- renderBookingCard(booking) %>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<hr class="my-4 text-muted">

<!-- 5. RECENT / ALL BOOKINGS SECTION -->
<div id="my-bookings" class="row mb-5">
  <div class="col-12">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
      <div>
        <h4 class="fw-bold mb-1">
          <i class="fa-solid fa-calendar-days text-danger me-2"></i>Recent Bookings
          <span class="badge bg-secondary fs-6 align-middle ms-1"><%= counts.totalBookings %></span>
        </h4>
        <p class="text-muted small mb-0">All your reservations with check-in details, price breakdown, and actions</p>
      </div>
      <div>
        <a href="/listings" class="btn btn-sm btn-outline-danger fw-semibold">
          <i class="fa-solid fa-magnifying-glass me-1"></i>Find Stays
        </a>
      </div>
    </div>

    <!-- Category Filter Tabs: All, Upcoming, Completed, Cancelled -->
    <ul class="nav nav-pills mb-4 gap-2" id="bookingFilterTabs" role="tablist">
      <li class="nav-item" role="presentation">
        <button class="nav-link active rounded-pill px-3 py-1 fw-semibold" id="tab-all-btn" data-bs-toggle="pill" data-bs-target="#tab-all" type="button" role="tab" aria-selected="true">
          All Bookings (<%= allBookings ? allBookings.length : 0 %>)
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-3 py-1 fw-semibold text-success" id="tab-upcoming-btn" data-bs-toggle="pill" data-bs-target="#tab-upcoming" type="button" role="tab" aria-selected="false">
          <i class="fa-solid fa-clock me-1"></i>Upcoming (<%= upcomingBookings ? upcomingBookings.length : 0 %>)
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-3 py-1 fw-semibold text-secondary" id="tab-completed-btn" data-bs-toggle="pill" data-bs-target="#tab-completed" type="button" role="tab" aria-selected="false">
          <i class="fa-solid fa-circle-check me-1"></i>Completed (<%= completedBookings ? completedBookings.length : 0 %>)
        </button>
      </li>
      <li class="nav-item" role="presentation">
        <button class="nav-link rounded-pill px-3 py-1 fw-semibold text-danger" id="tab-cancelled-btn" data-bs-toggle="pill" data-bs-target="#tab-cancelled" type="button" role="tab" aria-selected="false">
          <i class="fa-solid fa-ban me-1"></i>Cancelled (<%= cancelledBookings ? cancelledBookings.length : 0 %>)
        </button>
      </li>
    </ul>

    <!-- Tab Content Panes -->
    <div class="tab-content" id="bookingFilterTabsContent">
      <!-- 1. All Bookings Pane -->
      <div class="tab-pane fade show active" id="tab-all" role="tabpanel" aria-labelledby="tab-all-btn">
        <% if (!allBookings || allBookings.length === 0) { %>
          <div class="card border shadow-sm rounded-4 p-5 text-center my-3">
            <div class="py-3">
              <i class="fa-regular fa-calendar-xmark fa-3x text-muted mb-3 opacity-50"></i>
              <h5 class="fw-bold">No bookings yet</h5>
              <p class="text-muted small mb-3">When you reserve a place to stay, your booking details will appear here.</p>
              <a href="/listings" class="btn add-btn text-white px-4 py-2 fw-semibold shadow-sm">Explore Listings</a>
            </div>
          </div>
        <% } else { %>
          <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            <% for (let booking of allBookings) { %>
              <%- renderBookingCard(booking) %>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- 2. Upcoming Bookings Pane -->
      <div class="tab-pane fade" id="tab-upcoming" role="tabpanel" aria-labelledby="tab-upcoming-btn">
        <% if (!upcomingBookings || upcomingBookings.length === 0) { %>
          <div class="card border shadow-sm rounded-4 p-4 text-center my-3">
            <p class="text-muted mb-0"><i class="fa-regular fa-clock me-1"></i>You have no upcoming stays booked.</p>
          </div>
        <% } else { %>
          <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            <% for (let booking of upcomingBookings) { %>
              <%- renderBookingCard(booking) %>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- 3. Completed Bookings Pane -->
      <div class="tab-pane fade" id="tab-completed" role="tabpanel" aria-labelledby="tab-completed-btn">
        <% if (!completedBookings || completedBookings.length === 0) { %>
          <div class="card border shadow-sm rounded-4 p-4 text-center my-3">
            <p class="text-muted mb-0"><i class="fa-solid fa-circle-check me-1"></i>No completed stays yet.</p>
          </div>
        <% } else { %>
          <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            <% for (let booking of completedBookings) { %>
              <%- renderBookingCard(booking) %>
            <% } %>
          </div>
        <% } %>
      </div>

      <!-- 4. Cancelled Bookings Pane -->
      <div class="tab-pane fade" id="tab-cancelled" role="tabpanel" aria-labelledby="tab-cancelled-btn">
        <% if (!cancelledBookings || cancelledBookings.length === 0) { %>
          <div class="card border shadow-sm rounded-4 p-4 text-center my-3">
            <p class="text-muted mb-0"><i class="fa-solid fa-ban me-1"></i>No cancelled bookings.</p>
          </div>
        <% } else { %>
          <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
            <% for (let booking of cancelledBookings) { %>
              <%- renderBookingCard(booking) %>
            <% } %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<hr class="my-5 text-muted">

<!-- 6. MY LISTINGS & PROFILE OVERVIEW SECTION -->
<div class="row g-4 mb-5">
  <!-- Left Column: My Listings Section -->
  <div class="col-12 col-lg-8">
    <div id="my-listings" class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-bold mb-0">
        <i class="fa-solid fa-house-chimney text-danger me-2"></i>My Listings
        <span class="badge bg-secondary fs-6 align-middle ms-1"><%= counts.totalListings %></span>
      </h4>
        <% if (user.role === "HOST") { %>
          <a href="/listings/new" class="btn btn-sm btn-outline-danger fw-semibold">
            <i class="fa-solid fa-plus me-1"></i>Host New
          </a>
        <% } else { %>
          <a href="/become-host" class="btn btn-sm btn-outline-danger fw-semibold">
            <i class="fa-solid fa-house-chimney-user me-1"></i>Become a Host
          </a>
        <% } %>
    </div>

    <% if (!userListings || userListings.length === 0) { %>
      <div class="card border shadow-sm rounded-4 p-5 text-center my-3">
        <div class="py-3">
          <i class="fa-solid fa-house-circle-check fa-3x text-muted mb-3 opacity-50"></i>
          <h5 class="fw-bold">You haven't created any listings yet.</h5>
          <p class="text-muted small mb-3">Share your place with guests from around the world and start hosting.</p>
          <% if (user.role === "HOST") { %>
            <a href="/listings/new" class="btn add-btn text-white px-4 py-2 fw-semibold shadow-sm">
              <i class="fa-solid fa-plus me-1"></i>Add New Listing
            </a>
          <% } else { %>
            <a href="/become-host" class="btn add-btn text-white px-4 py-2 fw-semibold shadow-sm">
              <i class="fa-solid fa-house-chimney-user me-1"></i>Become a Host to List
            </a>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-sm-2 g-3">
        <% for (let listing of userListings) { %>
          <div class="col">
            <div class="card h-100 border shadow-sm rounded-4 overflow-hidden">
              <div class="position-relative">
                <img
                  src="<%= (listing.image && listing.image.url) ? listing.image.url : '/images/default.jpg' %>"
                  class="card-img-top object-fit-cover"
                  style="height: 180px; border-radius: 1rem 1rem 0 0 !important;"
                  alt="<%= listing.title %>"
                />
                <% if (listing.category) { %>
                  <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 px-2 py-1 small">
                    <%= listing.category %>
                  </span>
                <% } %>
              </div>
              <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div>
                  <h6 class="fw-bold mb-1 text-truncate" title="<%= listing.title %>">
                    <%= listing.title %>
                  </h6>
                  <p class="text-muted small mb-2 text-truncate">
                    <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                    <%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %>
                  </p>
                  <p class="mb-3">
                    <span class="fw-bold">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></span>
                    <span class="text-muted small">/ night</span>
                  </p>
                </div>
                <div class="d-flex gap-2">
                  <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-dark flex-fill fw-medium">
                    View
                  </a>
                  <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-secondary px-2 fw-medium" title="Edit Listing">
                    <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                  </a>
                  <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0" data-confirm="Are you sure you want to delete this listing?">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger px-2 fw-medium" title="Delete Listing">
                      <i class="fa-solid fa-trash-can me-1"></i>Delete
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- Right Column: User Profile Overview Card -->
  <div class="col-12 col-lg-4">
    <div id="profile-section" class="card border shadow-sm rounded-4 p-4 bg-white sticky-lg-top" style="top: 90px;">
      <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h5 class="fw-bold mb-0">
          <i class="fa-regular fa-id-card me-2 text-danger"></i>Profile Overview
        </h5>
        <a href="/profile/edit" class="btn btn-sm btn-outline-danger py-1 px-2 fw-medium" style="font-size: 0.8rem;">
          <i class="fa-solid fa-user-pen me-1"></i>Edit
        </a>
      </div>

      <div class="mb-3">
        <span class="text-muted small text-uppercase fw-semibold d-block">Username</span>
        <span class="fs-6 fw-bold text-dark"><%= user.username %></span>
      </div>

      <% if (user.email) { %>
        <div class="mb-3">
          <span class="text-muted small text-uppercase fw-semibold d-block">Email Address</span>
          <span class="fw-semibold text-secondary"><%= user.email %></span>
        </div>
      <% } %>

      <div class="mb-3">
        <span class="text-muted small text-uppercase fw-semibold d-block">Member Since</span>
        <span class="fw-semibold text-secondary">
          <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) : (user._id ? new Date(user._id.getTimestamp()).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) : "Active Member") %>
        </span>
      </div>

      <div class="mb-4">
        <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Account Status</span>
        <span class="badge bg-success bg-opacity-10 text-success fw-semibold px-2 py-1">
          <i class="fa-solid fa-circle-check me-1"></i>Active &bull; Authenticated
        </span>
      </div>

      <div class="mb-4">
        <span class="text-muted small text-uppercase fw-semibold d-block mb-1">Account Role</span>
        <% if (user.role === "HOST") { %>
          <span class="badge bg-danger bg-opacity-10 text-danger fw-semibold px-2 py-1">
            <i class="fa-solid fa-house-circle-check me-1"></i>Host
          </span>
        <% } else if (user.role === "ADMIN") { %>
          <span class="badge bg-dark bg-opacity-10 text-dark fw-semibold px-2 py-1">
            <i class="fa-solid fa-shield-halved me-1"></i>Administrator
          </span>
        <% } else { %>
          <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold px-2 py-1">
            <i class="fa-solid fa-user me-1"></i>Traveler (User)
          </span>
        <% } %>
      </div>

      <div class="d-grid gap-2">
        <a href="/profile/edit" class="btn btn-outline-dark fw-semibold">
          <i class="fa-solid fa-user-pen me-1"></i>Edit Profile
        </a>
        <% if (user.role === "USER") { %>
          <a href="/become-host" class="btn btn-danger text-white fw-semibold">
            <i class="fa-solid fa-house-chimney-user me-1"></i>Become a Host
          </a>
        <% } else if (user.role === "HOST") { %>
          <a href="/host/dashboard" class="btn btn-outline-primary fw-semibold">
            <i class="fa-solid fa-hotel me-1"></i>Host Dashboard
          </a>
        <% } %>
        <a href="/wishlist" class="btn btn-outline-secondary">
          <i class="fa-solid fa-heart text-danger me-1"></i>View Wishlist (<%= counts.wishlistCount %>)
        </a>
        <a href="/logout" class="btn btn-outline-danger">
          <i class="fa-solid fa-arrow-right-from-bracket me-1"></i>Logout
        </a>
      </div>
    </div>
  </div>
</div>

<hr class="my-5 text-muted">

<!-- 7. WISHLIST SHORTCUT SECTION -->
<div id="wishlist-section" class="row mb-5">
  <div class="col-12">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-bold mb-0">
        <i class="fa-solid fa-heart text-danger me-2"></i>My Saved Stays
        <span class="badge bg-danger fs-6 align-middle ms-1"><%= counts.wishlistCount %></span>
      </h4>
      <a href="/wishlist" class="small text-decoration-none fw-semibold text-danger">
        View All Wishlist &rarr;
      </a>
    </div>

    <% if (!wishlist || wishlist.length === 0) { %>
      <div class="card border shadow-sm rounded-4 p-4 text-center my-2">
        <div class="py-2">
          <i class="fa-regular fa-heart fa-2x text-danger opacity-50 mb-2"></i>
          <h6 class="fw-bold mb-1">Your wishlist is empty</h6>
          <p class="text-muted small mb-3">Save properties you like so you can easily find them later.</p>
          <a href="/listings" class="btn btn-sm btn-outline-danger px-4 py-2 fw-semibold">
            Browse Listings
          </a>
        </div>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
        <% for (let item of wishlist) { %>
          <div class="col">
            <div class="card h-100 border shadow-sm rounded-4 overflow-hidden">
              <div class="position-relative">
                <img
                  src="<%= (item.image && item.image.url) ? item.image.url : '/images/default.jpg' %>"
                  class="card-img-top object-fit-cover"
                  style="height: 160px; border-radius: 1rem 1rem 0 0 !important;"
                  alt="<%= item.title %>"
                />
                <% if (item.category) { %>
                  <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 px-2 py-1 small">
                    <%= item.category %>
                  </span>
                <% } %>
                <!-- Wishlist Remove Heart Icon Form -->
                <form method="POST" action="/listings/<%= item._id %>/wishlist" class="m-0 position-absolute top-0 end-0 m-2">
                  <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                  <button type="submit" class="btn btn-sm btn-light bg-white rounded-circle shadow-sm p-1" style="width: 32px; height: 32px;" title="Remove from wishlist">
                    <i class="fa-solid fa-heart text-danger"></i>
                  </button>
                </form>
              </div>
              <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div>
                  <h6 class="fw-bold mb-1 text-truncate" title="<%= item.title %>">
                    <%= item.title %>
                  </h6>
                  <p class="text-muted small mb-2 text-truncate">
                    <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                    <%= item.location %><% if (item.country) { %>, <%= item.country %><% } %>
                  </p>
                  <p class="mb-2">
                    <span class="fw-bold">&#8377;<%= item.price ? item.price.toLocaleString("en-IN") : "0" %></span>
                    <span class="text-muted small">/ night</span>
                  </p>
                </div>
                <div>
                  <a href="/listings/<%= item._id %>" class="btn btn-sm btn-outline-dark w-100 fw-medium">
                    View Details
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<%
/**
 * Helper function to render a single booking card with all required fields
 */
function renderBookingCard(booking) {
  const isCancelled = booking.status === "CANCELLED";
  const isCompleted = booking.category === "completed";
  const isUpcoming = booking.category === "upcoming";

  let statusBadgeClass = "bg-warning text-dark";
  let statusIcon = "fa-solid fa-clock";
  let borderClass = "";

  if (isCancelled) {
    statusBadgeClass = "bg-danger text-white";
    statusIcon = "fa-solid fa-ban";
    borderClass = "border-start border-4 border-danger opacity-85";
  } else if (isCompleted) {
    statusBadgeClass = "bg-secondary text-white";
    statusIcon = "fa-solid fa-circle-check";
    borderClass = "border-start border-4 border-secondary";
  } else if (booking.status === "CONFIRMED") {
    statusBadgeClass = "bg-success text-white";
    statusIcon = "fa-solid fa-circle-check";
    borderClass = "border-start border-4 border-success";
  } else if (booking.status === "AWAITING_HOST_APPROVAL") {
    statusBadgeClass = "bg-primary text-white";
    statusIcon = "fa-solid fa-clock-rotate-left";
    borderClass = "border-start border-4 border-primary";
  } else {
    statusBadgeClass = "bg-warning text-dark";
    statusIcon = "fa-regular fa-clock";
    borderClass = "border-start border-4 border-warning";
  }

  const checkInDateStr = new Date(booking.checkInDate || booking.checkIn).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
  const checkOutDateStr = new Date(booking.checkOutDate || booking.checkOut).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
  const bookedOnStr = new Date(booking.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
  const nights = booking.numberOfNights || 1;
  const toRupees = (val) => (booking.isPaise ? Math.round(val || 0) / 100 : (val || 0));
  const pricePerNight = booking.pricePerNight != null ? toRupees(booking.pricePerNight) : (booking.listing ? booking.listing.price : 0);
  const basePrice = booking.basePrice != null ? toRupees(booking.basePrice) : toRupees(booking.totalPrice);
  const taxRate = booking.taxRate != null ? booking.taxRate : 5;
  const taxAmount = booking.taxAmount != null ? toRupees(booking.taxAmount) : 0;
  const totalPrice = booking.totalPrice != null ? toRupees(booking.totalPrice) : 0;

  return `
    <div class="col">
      <div class="card h-100 border shadow-sm rounded-4 overflow-hidden ${borderClass}">
        <!-- Listing Image & Status -->
        <div class="position-relative">
          <img
            src="${(booking.listing && booking.listing.image && booking.listing.image.url) ? booking.listing.image.url : '/images/default.jpg'}"
            class="card-img-top object-fit-cover"
            style="height: 190px; border-radius: 1rem 1rem 0 0 !important;"
            alt="${booking.listing ? booking.listing.title : 'Listing'}"
          />
          <!-- Category Indicator (Upcoming, Completed, Cancelled) -->
          <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 px-2 py-1 small">
            ${isUpcoming ? '<i class="fa-solid fa-clock text-warning me-1"></i>Upcoming' : (isCompleted ? '<i class="fa-solid fa-circle-check text-info me-1"></i>Completed' : '<i class="fa-solid fa-ban text-danger me-1"></i>Cancelled')}
          </span>
          <!-- Status Badges: Booking Status & Payment Status -->
          <div class="position-absolute top-0 end-0 m-2 d-flex flex-column align-items-end gap-1">
            <span class="badge ${statusBadgeClass} px-3 py-2 shadow-sm">
              <i class="${statusIcon} me-1"></i>${booking.status}
            </span>
            ${booking.paymentStatus === "PAID" ? `
              <span class="badge bg-success text-white px-2 py-1 shadow-sm small">
                <i class="fa-solid fa-receipt me-1"></i>PAID
              </span>
            ` : (booking.paymentStatus === "REFUNDED" ? `
              <span class="badge bg-secondary text-white px-2 py-1 shadow-sm small">
                <i class="fa-solid fa-rotate-left me-1"></i>REFUNDED
              </span>
            ` : (booking.paymentStatus === "FAILED" ? `
              <span class="badge bg-danger text-white px-2 py-1 shadow-sm small">
                <i class="fa-solid fa-circle-xmark me-1"></i>FAILED
              </span>
            ` : (!isCancelled ? `
              <span class="badge bg-warning text-dark px-2 py-1 shadow-sm small">
                <i class="fa-solid fa-hourglass-half me-1"></i>UNPAID
              </span>
            ` : '')))}
          </div>
        </div>

        <div class="card-body p-3 d-flex flex-column justify-content-between">
          <div>
            <h5 class="card-title fw-bold mb-1 text-truncate" title="${booking.listing ? booking.listing.title : 'Listing'}">
              ${booking.listing ? booking.listing.title : 'Listing Unavailable'}
            </h5>
            <p class="text-muted small mb-3 text-truncate">
              <i class="fa-solid fa-location-dot me-1 text-danger"></i>
              ${booking.listing ? booking.listing.location : 'N/A'}${booking.listing && booking.listing.country ? ', ' + booking.listing.country : ''}
            </p>

            <!-- Stay Timing & Guests -->
            <div class="bg-light rounded-3 p-3 mb-3 small">
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted"><i class="fa-regular fa-calendar-plus me-1"></i>Check-in:</span>
                <span class="fw-semibold">${checkInDateStr} ${booking.checkInTime ? '<small class=\"text-muted\">(' + booking.checkInTime + ')</small>' : ''}</span>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted"><i class="fa-regular fa-calendar-minus me-1"></i>Check-out:</span>
                <span class="fw-semibold">${checkOutDateStr} ${booking.checkOutTime ? '<small class=\"text-muted\">(' + booking.checkOutTime + ')</small>' : ''}</span>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted"><i class="fa-solid fa-user-group me-1"></i>Guests:</span>
                <span class="fw-semibold">${booking.guests} ${booking.guests === 1 ? 'guest' : 'guests'}</span>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted"><i class="fa-solid fa-moon me-1"></i>Stay:</span>
                <span class="fw-semibold">${nights} ${nights === 1 ? 'night' : 'nights'}</span>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted"><i class="fa-solid fa-tag me-1"></i>Rate / night:</span>
                <span class="fw-semibold">&#8377;${pricePerNight.toLocaleString("en-IN")}</span>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Base Price:</span>
                <span class="fw-semibold">&#8377;${basePrice.toLocaleString("en-IN")}</span>
              </div>
              <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">GST (${taxRate}%):</span>
                <span class="fw-semibold">&#8377;${taxAmount.toLocaleString("en-IN")}</span>
              </div>
              <div class="d-flex justify-content-between border-top pt-1 mt-1 text-muted" style="font-size: 0.75rem;">
                <span>Booked on:</span>
                <span>${bookedOnStr}</span>
              </div>
            </div>

            <!-- Total Price -->
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="text-muted small">Total Price:</span>
              <span class="fs-5 fw-bold text-danger">&#8377;${totalPrice.toLocaleString("en-IN")}</span>
            </div>
          </div>

          <!-- Actions: View, Pay Now, Retry & Cancel -->
          <div class="d-flex gap-2 flex-wrap align-items-center pt-2 border-top">
            <a href="/bookings/${booking._id}" class="btn btn-outline-dark flex-grow-1 py-2 px-3 fw-semibold rounded-pill">
              <i class="fa-solid fa-circle-info me-1"></i>View Details
            </a>
            ${(!isCancelled && (booking.paymentStatus === "PENDING" || !booking.paymentStatus)) ? `
              <a href="/bookings/${booking._id}/payment" class="btn btn-danger add-btn px-3 py-2 fw-semibold text-white rounded-pill shadow-sm">
                <i class="fa-solid fa-credit-card me-1"></i>Pay Now
              </a>
            ` : (booking.paymentStatus === "FAILED" && !isCancelled ? `
              <a href="/bookings/${booking._id}/payment" class="btn btn-outline-danger px-3 py-2 fw-semibold rounded-pill">
                <i class="fa-solid fa-rotate-right me-1"></i>Retry Payment
              </a>
            ` : '')}
            ${(!isCancelled && (booking.status === "PENDING_PAYMENT" || booking.status === "PENDING" || booking.status === "AWAITING_HOST_APPROVAL" || booking.status === "CONFIRMED")) ? `
              ${booking.paymentStatus === "PAID" ? `
                <form method="POST" action="/bookings/${booking._id}/cancel" class="m-0" data-confirm="Are you sure you want to cancel this booking? A full refund of ₹${totalPrice.toLocaleString('en-IN')} will be automatically processed.">
                  <input type="hidden" name="_csrf" value="${typeof csrfToken !== 'undefined' ? csrfToken : ''}">
                  <button type="submit" class="btn btn-outline-danger py-2 px-3 fw-semibold rounded-pill" title="Cancel Booking & Refund">
                    <i class="fa-solid fa-ban me-1"></i>Cancel & Refund
                  </button>
                </form>
              ` : `
                <form method="POST" action="/bookings/${booking._id}/cancel" class="m-0" data-confirm="Are you sure you want to cancel this booking?">
                  <input type="hidden" name="_csrf" value="${typeof csrfToken !== 'undefined' ? csrfToken : ''}">
                  <button type="submit" class="btn btn-outline-danger py-2 px-3 fw-semibold rounded-pill" title="Cancel Booking">
                    <i class="fa-solid fa-ban me-1"></i>Cancel
                  </button>
                </form>
              `}
            ` : ''}
          </div>
        </div>
      </div>
    </div>
  `;
}
%>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.addEventListener("submit", function (e) {
      const form = e.target;
      if (form && form.matches && form.matches("[data-confirm]")) {
        const message = form.getAttribute("data-confirm");
        if (message && !window.confirm(message)) {
          e.preventDefault();
          e.stopPropagation();
        }
      }
    });
  });
</script>

