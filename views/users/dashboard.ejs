<% layout("/layouts/boilerplate") %>

<!-- 1. Header / Welcome Banner with Smooth Entry Animation -->
<div class="dashboard-animated-section mb-4">
  <div class="wl-dashboard-welcome">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div class="d-flex align-items-center gap-3">
        <div class="wl-dashboard-avatar">
          <%= user.username ? user.username.charAt(0).toUpperCase() : "U" %>
        </div>
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0 text-dark" style="font-size: 1.65rem;">
              Welcome back, <%= user.username ? user.username : "Traveler" %>! 👋
            </h2>
            <% if (user.role === "HOST") { %>
              <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1 rounded-pill" style="font-size: 0.72rem;">Host</span>
            <% } else { %>
              <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 rounded-pill" style="font-size: 0.72rem;">Traveler</span>
            <% } %>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">
            <% if (user.email) { %>
              <span><i class="fa-regular fa-envelope me-1 text-secondary"></i><%= user.email %></span>
              <span>&bull;</span>
            <% } %>
            <span class="text-success fw-semibold"><i class="fa-solid fa-shield-halved me-1"></i>Verified Member</span>
          </div>
        </div>
      </div>
      <div class="d-flex gap-2 flex-wrap">
        <a href="/profile/edit" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-2 fw-semibold">
          <i class="fa-solid fa-user-pen me-1"></i>Edit Profile
        </a>
        <% if (user.role === "USER") { %>
          <a href="/become-host" class="btn btn-sm text-white rounded-pill px-3 py-2 fw-semibold" style="background-color: #FF385C;">
            <i class="fa-solid fa-house-chimney-user me-1"></i>Become a Host
          </a>
        <% } else if (user.role === "HOST") { %>
          <a href="/host/dashboard" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 fw-semibold">
            <i class="fa-solid fa-gauge-high me-1"></i>Host Hub
          </a>
          <a href="/listings/new" class="btn btn-sm text-white rounded-pill px-3 py-2 fw-semibold" style="background-color: #FF385C;">
            <i class="fa-solid fa-plus me-1"></i>Add Listing
          </a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- 2. Animated KPI Cards (6 Well-Proportioned Metric Blocks) -->
<div class="dashboard-animated-section mb-4">
  <div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3">
    <!-- 1. Total Bookings -->
    <div class="col">
      <a href="#my-bookings" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Total Bookings</span>
          <div class="wl-kpi-icon-pill" style="background-color: #EFF6FF; color: #2563EB;">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.totalBookings %></div>
        <div class="wl-kpi-sub">
          <span>All reservations</span>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #3B82F6;"></div>
      </a>
    </div>

    <!-- 2. Upcoming Stays -->
    <div class="col">
      <a href="#upcoming-bookings" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Upcoming</span>
          <div class="wl-kpi-icon-pill" style="background-color: #ECFDF5; color: #059669;">
            <i class="fa-solid fa-plane-departure"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.upcomingBookings %></div>
        <div class="wl-kpi-sub">
          <span>Future trips</span>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #10B981;"></div>
      </a>
    </div>

    <!-- 3. Completed Stays -->
    <div class="col">
      <a href="#my-bookings" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Completed</span>
          <div class="wl-kpi-icon-pill" style="background-color: #F0FDFA; color: #0D9488;">
            <i class="fa-solid fa-circle-check"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.completedBookings %></div>
        <div class="wl-kpi-sub">
          <span>Past journeys</span>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #14B8A6;"></div>
      </a>
    </div>

    <!-- 4. Cancelled Stays -->
    <div class="col">
      <a href="#my-bookings" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Cancelled</span>
          <div class="wl-kpi-icon-pill" style="background-color: #FFF1F2; color: #E11D48;">
            <i class="fa-solid fa-ban"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.cancelledBookings %></div>
        <div class="wl-kpi-sub">
          <span>Cancelled</span>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #F43F5E;"></div>
      </a>
    </div>

    <!-- 5. My Listings -->
    <div class="col">
      <a href="#my-listings" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Listings</span>
          <div class="wl-kpi-icon-pill" style="background-color: #F5F3FF; color: #7C3AED;">
            <i class="fa-solid fa-house-chimney"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.totalListings %></div>
        <div class="wl-kpi-sub">
          <span>Hosted places</span>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #8B5CF6;"></div>
      </a>
    </div>

    <!-- 6. Saved Wishlist -->
    <div class="col">
      <a href="#wishlist-section" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Wishlist</span>
          <div class="wl-kpi-icon-pill" style="background-color: #FFFBEB; color: #D97706;">
            <i class="fa-solid fa-heart"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.wishlistCount %></div>
        <div class="wl-kpi-sub">
          <span>Saved stays</span>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #F59E0B;"></div>
      </a>
    </div>
  </div>
</div>

<!-- 3. Streamlined Quick Navigation Bar -->
<div class="dashboard-animated-section mb-4">
  <div class="wl-quick-actions-bar">
    <div class="d-flex align-items-center gap-2">
      <i class="fa-solid fa-compass text-danger"></i>
      <span class="small fw-bold text-uppercase text-secondary" style="font-size: 0.72rem; letter-spacing: 0.05em;">Quick Navigation:</span>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <a href="/listings" class="wl-action-chip">
        <i class="fa-solid fa-magnifying-glass text-primary"></i> Find Stays
      </a>
      <a href="#my-bookings" class="wl-action-chip">
        <i class="fa-regular fa-calendar-check text-success"></i> My Bookings
      </a>
      <a href="#my-listings" class="wl-action-chip">
        <i class="fa-solid fa-house-user text-info"></i> My Listings
      </a>
      <a href="#wishlist-section" class="wl-action-chip">
        <i class="fa-regular fa-heart text-danger"></i> Wishlist
      </a>
      <% if (user.role === "HOST") { %>
        <a href="/host/dashboard" class="wl-action-chip">
          <i class="fa-solid fa-hotel text-primary"></i> Host Hub
        </a>
      <% } %>
    </div>
  </div>
</div>

<!-- 4. UPCOMING BOOKINGS SECTION -->
<div id="upcoming-bookings" class="dashboard-animated-section mb-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0 text-dark" style="font-size: 1.25rem;">
      <i class="fa-solid fa-clock text-success me-2"></i>Upcoming Stays
      <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill ms-2" style="font-size: 0.8rem;"><%= counts.upcomingBookings %></span>
    </h4>
    <a href="#my-bookings" class="small text-decoration-none fw-semibold text-danger">
      View All Bookings &rarr;
    </a>
  </div>

  <% if (!upcomingBookings || upcomingBookings.length === 0) { %>
    <div class="card border rounded-4 p-4 text-center bg-white shadow-sm my-2">
      <div class="py-2">
        <i class="fa-regular fa-calendar-plus fa-2x text-muted mb-2 opacity-50"></i>
        <h6 class="fw-bold mb-1">No upcoming stays</h6>
        <p class="text-muted small mb-3">You don't have any future trips reserved yet. Time to plan your next escape!</p>
        <a href="/listings" class="btn btn-sm btn-dark rounded-pill px-4 py-2 fw-semibold">
          Explore Stays
        </a>
      </div>
    </div>
  <% } else { %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
      <% for (let booking of upcomingBookings) { %>
        <%- renderBookingCard(booking) %>
      <% } %>
    </div>
  <% } %>
</div>

<hr class="my-4 text-muted opacity-25">

<!-- 5. RECENT / ALL BOOKINGS SECTION -->
<div id="my-bookings" class="dashboard-animated-section mb-5">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
    <div>
      <h4 class="fw-bold mb-1 text-dark" style="font-size: 1.25rem;">
        <i class="fa-solid fa-calendar-days text-danger me-2"></i>My Bookings
        <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill ms-1" style="font-size: 0.8rem;"><%= counts.totalBookings %></span>
      </h4>
      <p class="text-muted small mb-0">Overview of all confirmed, upcoming, and past reservations.</p>
    </div>
    <div>
      <a href="/listings" class="btn btn-sm btn-outline-dark rounded-pill px-3 fw-semibold">
        <i class="fa-solid fa-magnifying-glass me-1"></i>Book Another Stay
      </a>
    </div>
  </div>

  <!-- Category Filter Tabs: All, Upcoming, Completed, Cancelled -->
  <ul class="nav nav-pills mb-3 gap-2" id="bookingFilterTabs" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active rounded-pill px-3 py-1 fw-semibold small" id="tab-all-btn" data-bs-toggle="pill" data-bs-target="#tab-all" type="button" role="tab" aria-selected="true">
        All (<%= allBookings ? allBookings.length : 0 %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link rounded-pill px-3 py-1 fw-semibold small text-success" id="tab-upcoming-btn" data-bs-toggle="pill" data-bs-target="#tab-upcoming" type="button" role="tab" aria-selected="false">
        <i class="fa-solid fa-clock me-1"></i>Upcoming (<%= upcomingBookings ? upcomingBookings.length : 0 %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link rounded-pill px-3 py-1 fw-semibold small text-secondary" id="tab-completed-btn" data-bs-toggle="pill" data-bs-target="#tab-completed" type="button" role="tab" aria-selected="false">
        <i class="fa-solid fa-circle-check me-1"></i>Completed (<%= completedBookings ? completedBookings.length : 0 %>)
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link rounded-pill px-3 py-1 fw-semibold small text-danger" id="tab-cancelled-btn" data-bs-toggle="pill" data-bs-target="#tab-cancelled" type="button" role="tab" aria-selected="false">
        <i class="fa-solid fa-ban me-1"></i>Cancelled (<%= cancelledBookings ? cancelledBookings.length : 0 %>)
      </button>
    </li>
  </ul>

  <!-- Tab Content Panes -->
  <div class="tab-content" id="bookingFilterTabsContent">
    <!-- 1. All Bookings Pane -->
    <div class="tab-pane fade show active" id="tab-all" role="tabpanel" aria-labelledby="tab-all-btn">
      <% if (!allBookings || allBookings.length === 0) { %>
        <div class="card border rounded-4 p-5 text-center bg-white shadow-sm my-2">
          <div class="py-2">
            <i class="fa-regular fa-calendar-xmark fa-2x text-muted mb-2 opacity-50"></i>
            <h6 class="fw-bold mb-1">No bookings found</h6>
            <p class="text-muted small mb-3">When you reserve a place to stay, your booking cards will appear here.</p>
            <a href="/listings" class="btn btn-sm btn-dark rounded-pill px-4 py-2 fw-semibold">Browse Listings</a>
          </div>
        </div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
          <% for (let booking of allBookings) { %>
            <%- renderBookingCard(booking) %>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- 2. Upcoming Bookings Pane -->
    <div class="tab-pane fade" id="tab-upcoming" role="tabpanel" aria-labelledby="tab-upcoming-btn">
      <% if (!upcomingBookings || upcomingBookings.length === 0) { %>
        <div class="card border rounded-4 p-4 text-center bg-white shadow-sm my-2">
          <p class="text-muted small mb-0"><i class="fa-regular fa-clock me-1"></i>You have no upcoming stays booked.</p>
        </div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
          <% for (let booking of upcomingBookings) { %>
            <%- renderBookingCard(booking) %>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- 3. Completed Bookings Pane -->
    <div class="tab-pane fade" id="tab-completed" role="tabpanel" aria-labelledby="tab-completed-btn">
      <% if (!completedBookings || completedBookings.length === 0) { %>
        <div class="card border rounded-4 p-4 text-center bg-white shadow-sm my-2">
          <p class="text-muted small mb-0"><i class="fa-solid fa-circle-check me-1"></i>No completed stays yet.</p>
        </div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
          <% for (let booking of completedBookings) { %>
            <%- renderBookingCard(booking) %>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- 4. Cancelled Bookings Pane -->
    <div class="tab-pane fade" id="tab-cancelled" role="tabpanel" aria-labelledby="tab-cancelled-btn">
      <% if (!cancelledBookings || cancelledBookings.length === 0) { %>
        <div class="card border rounded-4 p-4 text-center bg-white shadow-sm my-2">
          <p class="text-muted small mb-0"><i class="fa-solid fa-ban me-1"></i>No cancelled bookings.</p>
        </div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
          <% for (let booking of cancelledBookings) { %>
            <%- renderBookingCard(booking) %>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<hr class="my-4 text-muted opacity-25">

<!-- 6. MY LISTINGS & PROFILE OVERVIEW SECTION (Balanced Split) -->
<div class="row g-4 mb-5">
  <!-- Left Column: My Listings Section -->
  <div class="col-12 col-lg-8">
    <div id="my-listings" class="d-flex justify-content-between align-items-center mb-3">
      <h4 class="fw-bold mb-0 text-dark" style="font-size: 1.25rem;">
        <i class="fa-solid fa-house-chimney text-danger me-2"></i>My Listings
        <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill ms-1" style="font-size: 0.8rem;"><%= counts.totalListings %></span>
      </h4>
      <% if (user.role === "HOST") { %>
        <a href="/listings/new" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
          <i class="fa-solid fa-plus me-1"></i>Add New Listing
        </a>
      <% } else { %>
        <a href="/become-host" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold">
          <i class="fa-solid fa-house-chimney-user me-1"></i>Become a Host
        </a>
      <% } %>
    </div>

    <% if (!userListings || userListings.length === 0) { %>
      <div class="card border rounded-4 p-5 text-center bg-white shadow-sm my-2">
        <div class="py-2">
          <i class="fa-solid fa-house-circle-check fa-2x text-muted mb-2 opacity-50"></i>
          <h6 class="fw-bold mb-1">No listings created yet</h6>
          <p class="text-muted small mb-3">Share your sanctuary or apartment with guests worldwide and earn.</p>
          <% if (user.role === "HOST") { %>
            <a href="/listings/new" class="btn btn-sm btn-danger rounded-pill px-4 py-2 fw-semibold">
              <i class="fa-solid fa-plus me-1"></i>Add Listing
            </a>
          <% } else { %>
            <a href="/become-host" class="btn btn-sm btn-danger rounded-pill px-4 py-2 fw-semibold">
              <i class="fa-solid fa-house-chimney-user me-1"></i>Become a Host
            </a>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-sm-2 g-3">
        <% for (let listing of userListings) { %>
          <div class="col">
            <div class="card h-100 border rounded-4 overflow-hidden shadow-sm bg-white" style="transition: transform 0.2s ease;">
              <div class="position-relative" style="height: 150px;">
                <img
                  src="<%= (listing.image && listing.image.url) ? listing.image.url : '/images/default.jpg' %>"
                  class="w-100 h-100 object-fit-cover"
                  alt="<%= listing.title %>"
                  loading="lazy"
                />
                <% if (listing.category) { %>
                  <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 rounded-pill px-2 py-1 small" style="font-size: 0.7rem;">
                    <%= listing.category %>
                  </span>
                <% } %>
              </div>
              <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div>
                  <h6 class="fw-bold mb-1 text-truncate" title="<%= listing.title %>">
                    <%= listing.title %>
                  </h6>
                  <p class="text-muted small mb-2 text-truncate" style="font-size: 0.78rem;">
                    <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                    <%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %>
                  </p>
                  <p class="mb-3">
                    <span class="fw-bold text-dark">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></span>
                    <span class="text-muted small" style="font-size: 0.75rem;">/ night</span>
                  </p>
                </div>
                <div class="d-flex gap-2">
                  <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-dark flex-fill rounded-pill fw-semibold" style="font-size: 0.78rem;">
                    View
                  </a>
                  <a href="/listings/<%= listing._id %>/edit" class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold" style="font-size: 0.78rem;" title="Edit Listing">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </a>
                  <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0" data-confirm="Are you sure you want to delete this listing?">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold" style="font-size: 0.78rem;" title="Delete Listing">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>

  <!-- Right Column: User Profile Overview Card -->
  <div class="col-12 col-lg-4">
    <div id="profile-section" class="card border rounded-4 p-4 bg-white shadow-sm sticky-lg-top" style="top: 90px;">
      <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
        <h5 class="fw-bold mb-0 text-dark" style="font-size: 1.1rem;">
          <i class="fa-regular fa-id-card me-2 text-danger"></i>Profile Details
        </h5>
        <a href="/profile/edit" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1 fw-semibold" style="font-size: 0.75rem;">
          <i class="fa-solid fa-pen me-1"></i>Edit
        </a>
      </div>

      <div class="mb-3">
        <span class="text-muted text-uppercase fw-semibold d-block" style="font-size: 0.68rem; letter-spacing: 0.04em;">Username</span>
        <span class="fs-6 fw-bold text-dark"><%= user.username %></span>
      </div>

      <% if (user.email) { %>
        <div class="mb-3">
          <span class="text-muted text-uppercase fw-semibold d-block" style="font-size: 0.68rem; letter-spacing: 0.04em;">Email Address</span>
          <span class="fw-semibold text-secondary small text-truncate d-block"><%= user.email %></span>
        </div>
      <% } %>

      <div class="mb-3">
        <span class="text-muted text-uppercase fw-semibold d-block" style="font-size: 0.68rem; letter-spacing: 0.04em;">Member Since</span>
        <span class="fw-semibold text-secondary small">
          <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) : (user._id ? new Date(user._id.getTimestamp()).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" }) : "Active Member") %>
        </span>
      </div>

      <div class="mb-3">
        <span class="text-muted text-uppercase fw-semibold d-block mb-1" style="font-size: 0.68rem; letter-spacing: 0.04em;">Account Status</span>
        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill fw-semibold px-2 py-1" style="font-size: 0.72rem;">
          <i class="fa-solid fa-circle-check me-1"></i>Active &bull; Authenticated
        </span>
      </div>

      <div class="mb-4">
        <span class="text-muted text-uppercase fw-semibold d-block mb-1" style="font-size: 0.68rem; letter-spacing: 0.04em;">Account Role</span>
        <% if (user.role === "HOST") { %>
          <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill fw-semibold px-2 py-1" style="font-size: 0.72rem;">
            <i class="fa-solid fa-house-circle-check me-1"></i>Host
          </span>
        <% } else if (user.role === "ADMIN") { %>
          <span class="badge bg-dark bg-opacity-10 text-dark border rounded-pill fw-semibold px-2 py-1" style="font-size: 0.72rem;">
            <i class="fa-solid fa-shield-halved me-1"></i>Administrator
          </span>
        <% } else { %>
          <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 rounded-pill fw-semibold px-2 py-1" style="font-size: 0.72rem;">
            <i class="fa-solid fa-user me-1"></i>Traveler
          </span>
        <% } %>
      </div>

      <div class="d-grid gap-2">
        <% if (user.role === "USER") { %>
          <a href="/become-host" class="btn btn-sm btn-danger rounded-pill fw-semibold py-2">
            <i class="fa-solid fa-house-chimney-user me-1"></i>Become a Host
          </a>
        <% } else if (user.role === "HOST") { %>
          <a href="/host/dashboard" class="btn btn-sm btn-outline-primary rounded-pill fw-semibold py-2">
            <i class="fa-solid fa-gauge-high me-1"></i>Host Hub
          </a>
        <% } %>
        <a href="/wishlist" class="btn btn-sm btn-outline-secondary rounded-pill fw-semibold py-2">
          <i class="fa-solid fa-heart text-danger me-1"></i>Saved Wishlist (<%= counts.wishlistCount %>)
        </a>
        <a href="/logout" class="btn btn-sm btn-outline-danger rounded-pill fw-semibold py-2">
          <i class="fa-solid fa-arrow-right-from-bracket me-1"></i>Log Out
        </a>
      </div>
    </div>
  </div>
</div>

<hr class="my-4 text-muted opacity-25">

<!-- 7. WISHLIST SECTION (Compact Cards) -->
<div id="wishlist-section" class="dashboard-animated-section mb-5">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0 text-dark" style="font-size: 1.25rem;">
      <i class="fa-solid fa-heart text-danger me-2"></i>My Saved Stays
      <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill ms-1" style="font-size: 0.8rem;"><%= counts.wishlistCount %></span>
    </h4>
    <a href="/wishlist" class="small text-decoration-none fw-semibold text-danger">
      View All Saved &rarr;
    </a>
  </div>

  <% if (!wishlist || wishlist.length === 0) { %>
    <div class="card border rounded-4 p-4 text-center bg-white shadow-sm my-2">
      <div class="py-2">
        <i class="fa-regular fa-heart fa-2x text-danger opacity-50 mb-2"></i>
        <h6 class="fw-bold mb-1">Your wishlist is empty</h6>
        <p class="text-muted small mb-3">Save stays you love while browsing to easily compare and book later.</p>
        <a href="/listings" class="btn btn-sm btn-outline-danger rounded-pill px-4 py-2 fw-semibold">
          Discover Stays
        </a>
      </div>
    </div>
  <% } else { %>
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-3">
      <% for (let item of wishlist) { %>
        <div class="col">
          <div class="card h-100 border rounded-4 overflow-hidden shadow-sm bg-white" style="transition: transform 0.2s ease;">
            <div class="position-relative" style="height: 140px;">
              <img
                src="<%= (item.image && item.image.url) ? item.image.url : '/images/default.jpg' %>"
                class="w-100 h-100 object-fit-cover"
                alt="<%= item.title %>"
                loading="lazy"
              />
              <% if (item.category) { %>
                <span class="position-absolute top-0 start-0 m-2 badge bg-dark bg-opacity-75 rounded-pill px-2 py-1 small" style="font-size: 0.7rem;">
                  <%= item.category %>
                </span>
              <% } %>
              <!-- Wishlist Remove Heart Button -->
              <form method="POST" action="/listings/<%= item._id %>/wishlist" class="m-0 position-absolute top-0 end-0 m-2">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <button type="submit" class="btn btn-sm btn-light bg-white rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;" title="Remove from wishlist">
                  <i class="fa-solid fa-heart text-danger small"></i>
                </button>
              </form>
            </div>
            <div class="card-body p-3 d-flex flex-column justify-content-between">
              <div>
                <h6 class="fw-bold mb-1 text-truncate" title="<%= item.title %>" style="font-size: 0.9rem;">
                  <%= item.title %>
                </h6>
                <p class="text-muted small mb-2 text-truncate" style="font-size: 0.78rem;">
                  <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                  <%= item.location %><% if (item.country) { %>, <%= item.country %><% } %>
                </p>
                <p class="mb-2">
                  <span class="fw-bold text-dark">&#8377;<%= item.price ? item.price.toLocaleString("en-IN") : "0" %></span>
                  <span class="text-muted small" style="font-size: 0.75rem;">/ night</span>
                </p>
              </div>
              <div>
                <a href="/listings/<%= item._id %>" class="btn btn-sm btn-outline-dark w-100 rounded-pill fw-semibold" style="font-size: 0.78rem;">
                  View Details
                </a>
              </div>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</div>

<%
/**
 * Render an aesthetically proportioned, modern booking card
 */
function renderBookingCard(booking) {
  const isCancelled = booking.status === "CANCELLED";
  const isCompleted = booking.category === "completed";
  const isUpcoming = booking.category === "upcoming";

  let statusBadgeClass = "bg-warning text-dark";
  let statusIcon = "fa-solid fa-clock";

  if (isCancelled) {
    statusBadgeClass = "bg-danger text-white";
    statusIcon = "fa-solid fa-ban";
  } else if (isCompleted) {
    statusBadgeClass = "bg-secondary text-white";
    statusIcon = "fa-solid fa-circle-check";
  } else if (booking.status === "CONFIRMED") {
    statusBadgeClass = "bg-success text-white";
    statusIcon = "fa-solid fa-circle-check";
  } else if (booking.status === "AWAITING_HOST_APPROVAL") {
    statusBadgeClass = "bg-primary text-white";
    statusIcon = "fa-solid fa-clock-rotate-left";
  } else {
    statusBadgeClass = "bg-warning text-dark";
    statusIcon = "fa-regular fa-clock";
  }

  const checkInDateStr = new Date(booking.checkInDate || booking.checkIn).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
  const checkOutDateStr = new Date(booking.checkOutDate || booking.checkOut).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
  const nights = booking.numberOfNights || 1;
  const toRupees = (val) => (booking.isPaise ? Math.round(val || 0) / 100 : (val || 0));
  const totalPrice = booking.totalPrice != null ? toRupees(booking.totalPrice) : 0;

  return `
    <div class="col">
      <div class="wl-booking-card-pro">
        <!-- 16:9 Media -->
        <div class="wl-booking-media">
          <img
            src="${(booking.listing && booking.listing.image && booking.listing.image.url) ? booking.listing.image.url : '/images/default.jpg'}"
            alt="${booking.listing ? booking.listing.title : 'Listing'}"
            loading="lazy"
          />
          
          <!-- Category Indicator -->
          <span class="wl-booking-category-tag">
            ${isUpcoming ? '<i class="fa-solid fa-plane-departure me-1"></i>Upcoming' : (isCompleted ? '<i class="fa-solid fa-circle-check me-1"></i>Completed' : '<i class="fa-solid fa-ban me-1"></i>Cancelled')}
          </span>

          <!-- Status Badges -->
          <div class="wl-booking-status-badges">
            <span class="badge ${statusBadgeClass} rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.68rem;">
              <i class="${statusIcon} me-1"></i>${booking.status}
            </span>
            ${booking.paymentStatus === "PAID" ? `
              <span class="badge bg-success text-white rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.65rem;">
                <i class="fa-solid fa-receipt me-1"></i>PAID
              </span>
            ` : (booking.paymentStatus === "REFUNDED" ? `
              <span class="badge bg-secondary text-white rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.65rem;">
                <i class="fa-solid fa-rotate-left me-1"></i>REFUNDED
              </span>
            ` : (booking.paymentStatus === "FAILED" ? `
              <span class="badge bg-danger text-white rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.65rem;">
                <i class="fa-solid fa-circle-xmark me-1"></i>FAILED
              </span>
            ` : (!isCancelled ? `
              <span class="badge bg-warning text-dark rounded-pill px-2 py-1 shadow-sm" style="font-size: 0.65rem;">
                <i class="fa-solid fa-hourglass-half me-1"></i>UNPAID
              </span>
            ` : '')))}
          </div>
        </div>

        <!-- Body -->
        <div class="wl-booking-body">
          <h5 class="wl-booking-title" title="${booking.listing ? booking.listing.title : 'Listing'}">
            ${booking.listing ? booking.listing.title : 'Listing Unavailable'}
          </h5>
          <div class="wl-booking-location">
            <i class="fa-solid fa-location-dot small text-danger"></i>
            <span>${booking.listing ? booking.listing.location : 'N/A'}${booking.listing && booking.listing.country ? ', ' + booking.listing.country : ''}</span>
          </div>

          <!-- Compact 2x2 Meta Grid -->
          <div class="wl-booking-info-grid">
            <div class="wl-booking-info-item">
              <span class="wl-booking-info-label">Check-in</span>
              <span class="wl-booking-info-val"><i class="fa-regular fa-calendar me-1 text-muted"></i>${checkInDateStr}</span>
            </div>
            <div class="wl-booking-info-item">
              <span class="wl-booking-info-label">Check-out</span>
              <span class="wl-booking-info-val"><i class="fa-regular fa-calendar me-1 text-muted"></i>${checkOutDateStr}</span>
            </div>
            <div class="wl-booking-info-item">
              <span class="wl-booking-info-label">Stay</span>
              <span class="wl-booking-info-val"><i class="fa-solid fa-moon me-1 text-muted"></i>${nights} ${nights === 1 ? 'night' : 'nights'}</span>
            </div>
            <div class="wl-booking-info-item">
              <span class="wl-booking-info-label">Guests</span>
              <span class="wl-booking-info-val"><i class="fa-solid fa-user-group me-1 text-muted"></i>${booking.guests}</span>
            </div>
          </div>

          <!-- Price Row -->
          <div class="wl-booking-price-row">
            <span class="wl-booking-total-label">Total Amount:</span>
            <span class="wl-booking-total-val">&#8377;${totalPrice.toLocaleString("en-IN")}</span>
          </div>

          <!-- Actions -->
          <div class="wl-booking-actions">
            <a href="/bookings/${booking._id}" class="btn btn-outline-dark flex-grow-1">
              Details
            </a>
            ${(!isCancelled && (booking.paymentStatus === "PENDING" || !booking.paymentStatus)) ? `
              <a href="/bookings/${booking._id}/payment" class="btn btn-danger text-white">
                Pay Now
              </a>
            ` : (booking.paymentStatus === "FAILED" && !isCancelled ? `
              <a href="/bookings/${booking._id}/payment" class="btn btn-outline-danger">
                Retry
              </a>
            ` : '')}
            ${(!isCancelled && (booking.status === "PENDING_PAYMENT" || booking.status === "PENDING" || booking.status === "AWAITING_HOST_APPROVAL" || booking.status === "CONFIRMED")) ? `
              ${booking.paymentStatus === "PAID" ? `
                <form method="POST" action="/bookings/${booking._id}/cancel" class="m-0" data-confirm="Are you sure you want to cancel this booking? A full refund of ₹${totalPrice.toLocaleString('en-IN')} will be automatically processed.">
                  <input type="hidden" name="_csrf" value="${typeof csrfToken !== 'undefined' ? csrfToken : ''}">
                  <button type="submit" class="btn btn-outline-danger" title="Cancel Booking & Refund">
                    Cancel
                  </button>
                </form>
              ` : `
                <form method="POST" action="/bookings/${booking._id}/cancel" class="m-0" data-confirm="Are you sure you want to cancel this booking?">
                  <input type="hidden" name="_csrf" value="${typeof csrfToken !== 'undefined' ? csrfToken : ''}">
                  <button type="submit" class="btn btn-outline-danger" title="Cancel Booking">
                    Cancel
                  </button>
                </form>
              `}
            ` : ''}
          </div>
        </div>
      </div>
    </div>
  `;
}
%>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    document.addEventListener("submit", function (e) {
      const form = e.target;
      if (form && form.matches && form.matches("[data-confirm]")) {
        const message = form.getAttribute("data-confirm");
        if (message && !window.confirm(message)) {
          e.preventDefault();
          e.stopPropagation();
        }
      }
    });
  });
</script>


