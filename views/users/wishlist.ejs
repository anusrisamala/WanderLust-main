<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-2">
  <div class="col-12">
    <h3 class="fw-bold"><i class="fa-solid fa-heart text-danger me-2"></i>My Wishlist ❤️</h3>
  </div>
</div>

<% if (!wishlist || wishlist.length === 0) { %>
  <div class="row my-5">
    <div class="col-12 text-center">
      <div class="empty-wishlist-container">
        <i class="fa-solid fa-heart empty-wishlist-icon"></i>
        <h4 class="fw-bold mb-2">Your wishlist is empty ❤️</h4>
        <p class="text-muted mb-4">Explore listings and save your favorite stays for future trips.</p>
        <a href="/listings" class="btn btn-dark add-btn px-4 py-2">Explore Listings</a>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-lg-3 g-4 mt-1 mb-5">
    <% for (let listing of wishlist) { %>
      <div class="col">
        <div class="card listing-card wishlist-card h-100 position-relative shadow-sm">
          <!-- Wishlist remove button -->
          <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="m-0">
            <button type="submit" class="wishlist-floating-btn" title="Remove from wishlist">
              <i class="fa-solid fa-heart wishlist-heart-filled"></i>
            </button>
          </form>

          <a href="/listings/<%= listing._id %>" class="listing-link">
            <img
              src="<%= (listing.image && listing.image.url) ? listing.image.url : '' %>"
              class="card-img-top"
              alt="<%= listing.title %>"
            />
            <div class="card-body p-3">
              <p class="card-text mb-1">
                <b class="fs-6"><%= listing.title %></b>
              </p>
              <p class="card-text text-muted small mb-2">
                <i class="fa-solid fa-location-dot me-1"></i><%= listing.location %>, <%= listing.country %>
              </p>
              <p class="card-text mb-0">
                <span class="fw-bold">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></span> <span class="text-muted">/ night</span>
              </p>
            </div>
          </a>
        </div>
      </div>
    <% } %>
  </div>
<% } %>

