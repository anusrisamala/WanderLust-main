<% layout("/layouts/boilerplate") %>

<div class="row my-5 justify-content-center">
  <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
    <div class="card wl-card border-0 shadow-lg p-4 p-md-5 bg-white">
      <!-- Auth Header -->
      <div class="text-center mb-4">
        <a class="wl-brand-wrapper mb-3 d-inline-flex" href="/listings">
          <div class="wl-brand-mark">
            <i class="fa-solid fa-compass"></i>
          </div>
          <span class="wl-brand-title">WanderLust<span class="wl-brand-dot">.</span></span>
        </a>
        <h3 class="fw-bold mb-1 text-dark">Join WanderLust</h3>
        <p class="text-secondary small mb-0">Create an account to book stays and list properties</p>
      </div>

      <!-- Signup Form -->
      <form action="/signup" method="POST" class="needs-validation" novalidate>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

        <div class="mb-3">
          <label for="username" class="wl-form-label">Username</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-user text-muted"></i></span>
            <input
              name="username"
              id="username"
              type="text"
              class="form-control wl-form-control"
              placeholder="Choose a username"
              required
              autocomplete="username"
            />
            <div class="invalid-feedback">Please choose a username.</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="email" class="wl-form-label">Email Address</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-envelope text-muted"></i></span>
            <input
              name="email"
              id="email"
              type="email"
              class="form-control wl-form-control"
              placeholder="name@example.com"
              required
              autocomplete="email"
            />
            <div class="invalid-feedback">Please enter a valid email address.</div>
          </div>
        </div>

        <div class="mb-4">
          <label for="password" class="wl-form-label">Password</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fa-solid fa-lock text-muted"></i></span>
            <input
              name="password"
              id="password"
              type="password"
              class="form-control wl-form-control"
              placeholder="At least 6 characters"
              required
              autocomplete="new-password"
            />
            <div class="invalid-feedback">Please enter a password.</div>
          </div>
        </div>

        <button class="wl-btn wl-btn-primary wl-btn-pill w-100 py-3 fw-bold shadow-sm mb-3 add-btn" type="submit">
          Create Free Account
        </button>

        <div class="text-center pt-2 border-top">
          <span class="text-secondary small">Already have an account?</span>
          <a href="/login" class="text-danger fw-bold small text-decoration-none ms-1">Sign In</a>
        </div>
      </form>
    </div>
  </div>
</div>