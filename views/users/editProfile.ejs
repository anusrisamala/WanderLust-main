<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5 justify-content-center">
  <div class="col-12 col-md-8 col-lg-6">
    <!-- Back to Dashboard -->
    <div class="mb-3">
      <a href="/dashboard" class="wl-btn wl-btn-ghost wl-btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Dashboard
      </a>
    </div>

    <div class="wl-form-card p-4 p-md-5">
      <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div class="stat-icon-wrapper rounded-circle" style="width: 52px; height: 52px; background-color: var(--wl-primary-subtle); color: var(--wl-primary);">
          <i class="fa-solid fa-user-pen fa-lg"></i>
        </div>
        <div>
          <h3 class="fw-bold mb-0 fs-4">Edit Profile</h3>
          <p class="text-muted small mb-0">Update your username and contact email</p>
        </div>
      </div>

      <!-- Edit Profile Form -->
      <form action="/profile" method="POST" novalidate class="needs-validation">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <!-- Username Input -->
        <div class="mb-4">
          <label for="username" class="form-label">
            Username <span class="text-danger">*</span>
          </label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted border-end-0"><i class="fa-solid fa-at"></i></span>
            <input
              type="text"
              name="username"
              id="username"
              class="form-control"
              value="<%= user.username %>"
              required
              minlength="2"
              maxlength="30"
              autocomplete="username"
            />
            <div class="invalid-feedback">Please enter a valid username (at least 2 characters).</div>
          </div>
          <div class="form-text small text-muted mt-1">
            Your unique username across WanderLust.
          </div>
        </div>

        <!-- Email Input -->
        <div class="mb-4">
          <label for="email" class="form-label">
            Email Address <span class="text-danger">*</span>
          </label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted border-end-0"><i class="fa-solid fa-envelope"></i></span>
            <input
              type="email"
              name="email"
              id="email"
              class="form-control"
              value="<%= user.email %>"
              required
              autocomplete="email"
            />
            <div class="invalid-feedback">Please enter a valid email address.</div>
          </div>
          <div class="form-text small text-muted mt-1">
            Used for booking confirmations and host notifications.
          </div>
        </div>

        <!-- Read-Only Account Information -->
        <div class="bg-light rounded-3 p-3 mb-4 small border">
          <span class="fw-bold text-secondary text-uppercase d-block mb-2" style="font-size: 0.75rem;">
            <i class="fa-solid fa-shield-halved me-1 text-success"></i>Account Security Details
          </span>
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted">Account ID:</span>
            <span class="text-secondary font-monospace"><%= user._id %></span>
          </div>
          <div class="d-flex justify-content-between">
            <span class="text-muted">Member Since:</span>
            <span class="text-secondary fw-medium">
              <%= user.createdAt ? new Date(user.createdAt).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : (user._id ? new Date(user._id.getTimestamp()).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" }) : "Active Member") %>
            </span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex gap-2">
          <button type="submit" class="wl-btn wl-btn-primary add-btn flex-fill">
            <i class="fa-solid fa-check me-1"></i>Save Changes
          </button>
          <a href="/dashboard" class="wl-btn wl-btn-outline">
            Cancel
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
