<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center my-4 my-md-5">
  <div class="col-12 col-md-8 col-lg-5">
    <div class="wl-form-card p-4 p-md-5">
      <!-- Header -->
      <div class="text-center mb-4">
        <div class="mb-3">
          <span class="wl-brand-icon" style="width: 48px; height: 48px; font-size: 1.4rem;">
            <i class="fa-solid fa-compass"></i>
          </span>
        </div>
        <h2 class="fw-bold mb-1 fs-3">Welcome Back</h2>
        <p class="text-muted small">Sign in to your WanderLust account</p>
      </div>

      <!-- Login Form -->
      <form action="/login" method="POST" class="needs-validation" novalidate>
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted border-end-0"><i class="fa-solid fa-user"></i></span>
            <input
              name="username"
              id="username"
              type="text"
              class="form-control"
              placeholder="Enter your username"
              required
              autocomplete="username"
            />
            <div class="invalid-feedback">Please enter your username.</div>
          </div>
        </div>

        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center mb-1">
            <label for="password" class="form-label mb-0">Password</label>
          </div>
          <div class="input-group">
            <span class="input-group-text bg-light text-muted border-end-0"><i class="fa-solid fa-lock"></i></span>
            <input
              name="password"
              id="password"
              type="password"
              class="form-control"
              placeholder="••••••••"
              required
              autocomplete="current-password"
            />
            <div class="invalid-feedback">Please enter your password.</div>
          </div>
        </div>

        <button class="wl-btn wl-btn-primary btn-success w-100 py-2 fw-bold mb-3 shadow-xs">
          Sign In
        </button>

        <div class="text-center pt-3 border-top">
          <p class="text-muted small mb-0">
            Don't have an account yet? 
            <a href="/signup" class="fw-bold text-decoration-none" style="color: var(--wl-secondary);">Create an account</a>
          </p>
        </div>
      </form>
    </div>
  </div>
</div>