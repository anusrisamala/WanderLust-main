<% layout("/layouts/boilerplate") %>

<div class="row mt-2 mb-5">
  <div class="col-12">
    <!-- Top Header / Title & Actions -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
      <div>
        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
          <% if (listing.category) { %>
            <span class="badge bg-light text-secondary border px-2 py-1 small text-uppercase">
              <i class="fa-solid fa-tag me-1 text-danger"></i><%= listing.category %>
            </span>
          <% } %>
          <% if (listing.isActive === false) { %>
            <span class="badge bg-secondary px-3 py-1 small"><i class="fa-solid fa-box-archive me-1"></i>Archived</span>
          <% } %>
        </div>
        <h2 class="fw-bold text-dark mb-1"><%= listing.title %></h2>
        <p class="text-secondary small mb-0 d-flex align-items-center gap-2 flex-wrap">
          <span><i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %></span>
          <span>•</span>
          <span><i class="fa-regular fa-user me-1 text-primary"></i>Hosted by <strong><%= listing.owner ? listing.owner.username : "Host" %></strong></span>
          <% if (listing.reviews && listing.reviews.length > 0) { %>
            <span>•</span>
            <span class="text-dark fw-semibold"><i class="fa-solid fa-star text-warning me-1"></i><%= listing.reviews.length %> <%= listing.reviews.length === 1 ? 'review' : 'reviews' %></span>
          <% } %>
        </p>
      </div>

      <!-- Action Buttons (Wishlist & Host Controls) -->
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <% if (currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
          <a href="/listings/<%= listing._id %>/edit" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill edit-btn">
            <i class="fa-solid fa-pen-to-square me-1"></i>Edit
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0" data-confirm="Archive this listing? It will be hidden from search, but all bookings, receipts, and reviews will be preserved.">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill text-danger border-danger">
              <i class="fa-solid fa-box-archive me-1"></i><%= listing.isActive === false ? 'Archived' : 'Archive' %>
            </button>
          </form>
        <% } %>

        <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="m-0" id="showWishlistForm" data-listing-id="<%= listing._id %>">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="wishlist-btn-show <%= (typeof isWishlisted !== 'undefined' && isWishlisted) ? 'is-saved' : '' %>" id="showWishlistBtn" title="<%= (typeof isWishlisted !== 'undefined' && isWishlisted) ? 'Remove from Wishlist' : 'Save to Wishlist' %>">
            <span class="wishlist-heart-box">
              <% if (typeof isWishlisted !== 'undefined' && isWishlisted) { %>
                <i class="fa-solid fa-heart wishlist-heart-icon wishlist-heart-filled"></i>
              <% } else { %>
                <i class="fa-regular fa-heart wishlist-heart-icon wishlist-heart-empty"></i>
              <% } %>
            </span>
            <span class="wishlist-btn-text"><%= (typeof isWishlisted !== 'undefined' && isWishlisted) ? 'Saved' : 'Save' %></span>
          </button>
        </form>
      </div>
    </div>

    <!-- Hero Image Showcase -->
    <div class="position-relative mb-4">
      <img
        src="<%= listing.image.url %>"
        class="wl-detail-hero-img"
        alt="<%= listing.title %>"
      />
    </div>

    <!-- Main Content & Reservation Sidebar -->
    <div class="row g-4 g-lg-5">
      <!-- Left Column: Details, Host, Amenities, Map & Reviews -->
      <div class="col-12 col-lg-7 col-xl-8">
        <!-- Host Profile Snippet -->
        <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4 bg-white">
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
              <div class="wl-avatar-circle" style="width: 52px; height: 52px; font-size: 1.25rem;">
                <%= listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
              </div>
              <div>
                <h5 class="fw-bold mb-0">Entire home hosted by <%= listing.owner ? listing.owner.username : "Host" %></h5>
                <p class="text-secondary small mb-0">Verified Property &bull; Dedicated Hospitality &bull; Fast Response</p>
              </div>
            </div>
            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fw-semibold small">
              <i class="fa-solid fa-shield-halved me-1"></i>Verified Host
            </span>
          </div>
        </div>

        <!-- Description -->
        <div class="mb-4 pb-3 border-bottom">
          <h4 class="fw-bold mb-3">About this space</h4>
          <p class="text-secondary" style="line-height: 1.75; font-size: 1.02rem; white-space: pre-line;">
            <%= listing.description %>
          </p>
        </div>

        <!-- What this place offers (Amenities) -->
        <div class="mb-4 pb-3 border-bottom">
          <h4 class="fw-bold mb-3">What this place offers</h4>
          <div class="row row-cols-1 row-cols-sm-2 g-3">
            <div class="col d-flex align-items-center gap-3 text-secondary">
              <i class="fa-solid fa-wifi fs-5 text-dark" style="width: 24px;"></i>
              <span>High-speed Wi-Fi</span>
            </div>
            <div class="col d-flex align-items-center gap-3 text-secondary">
              <i class="fa-solid fa-square-parking fs-5 text-dark" style="width: 24px;"></i>
              <span>Free parking on premises</span>
            </div>
            <div class="col d-flex align-items-center gap-3 text-secondary">
              <i class="fa-solid fa-snowflake fs-5 text-dark" style="width: 24px;"></i>
              <span>Air conditioning &amp; climate control</span>
            </div>
            <div class="col d-flex align-items-center gap-3 text-secondary">
              <i class="fa-solid fa-kitchen-set fs-5 text-dark" style="width: 24px;"></i>
              <span>Fully equipped kitchen</span>
            </div>
            <div class="col d-flex align-items-center gap-3 text-secondary">
              <i class="fa-solid fa-shield-virus fs-5 text-dark" style="width: 24px;"></i>
              <span>Smoke &amp; carbon monoxide alarm</span>
            </div>
            <div class="col d-flex align-items-center gap-3 text-secondary">
              <i class="fa-solid fa-bell-concierge fs-5 text-dark" style="width: 24px;"></i>
              <span>Dedicated host assistance</span>
            </div>
          </div>
        </div>

        <!-- Location & Map -->
        <div class="mb-4 pb-3 border-bottom">
          <h4 class="fw-bold mb-2">Where you'll be staying</h4>
          <p class="text-secondary small mb-3">
            <i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %>
          </p>
          <div id="map"></div>
          <small class="text-muted d-block mt-2">
            <i class="fa-solid fa-map-location-dot me-1"></i>High-availability map powered by Esri &amp; ArcGIS.
          </small>
        </div>

        <!-- Reviews Section -->
        <div id="reviews" class="mb-4 pt-2">
          <% if (typeof canReview !== 'undefined' && canReview) { %>
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
              <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                <h4 class="mb-0 fw-bold">Leave a Review</h4>
                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill fw-semibold small">
                  <i class="fa-solid fa-circle-check me-1"></i>Verified Guest Stay
                </span>
              </div>
              <p class="text-secondary small mb-3">You completed a stay at this property. Share your feedback with other travelers.</p>

              <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="mb-3">
                  <span class="wl-form-label mb-2">Your Rating</span>
                  <fieldset class="starability-slot" aria-label="Rating">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
                </div>

                <div class="mb-3">
                  <label for="comment" class="wl-form-label">Comments</label>
                  <textarea name="review[comment]" id="comment" rows="4" class="form-control wl-form-control" placeholder="Tell travelers about your stay, cleanliness, host communication..." required></textarea>
                  <div class="invalid-feedback">Please add some comment for your review</div>
                </div>
                <button class="wl-btn wl-btn-dark wl-btn-sm wl-btn-pill px-4">Submit Review</button>
              </form>
            </div>
          <% } else if (currUser) { %>
            <% if (typeof hasReviewed !== 'undefined' && hasReviewed) { %>
              <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-light">
                <div class="d-flex align-items-center">
                  <i class="fa-solid fa-circle-check text-info fs-3 me-3"></i>
                  <div>
                    <h6 class="mb-1 fw-bold text-dark">Thank you for your feedback!</h6>
                    <p class="mb-0 text-secondary small">You have already submitted a review for your verified stay.</p>
                  </div>
                </div>
              </div>
            <% } else if (typeof hasUpcomingStay !== 'undefined' && hasUpcomingStay) { %>
              <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-light">
                <div class="d-flex align-items-center">
                  <i class="fa-solid fa-calendar-check text-primary fs-3 me-3"></i>
                  <div>
                    <h6 class="mb-1 fw-bold text-dark">Upcoming Stay Confirmed</h6>
                    <p class="mb-0 text-secondary small">You can leave your verified review once your stay is completed.</p>
                  </div>
                </div>
              </div>
            <% } else if (typeof isListingOwner !== 'undefined' && isListingOwner) { %>
              <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-light text-secondary small">
                <i class="fa-solid fa-house-user me-2 text-primary"></i>You are the host of this property. Hosts cannot review their own listings.
              </div>
            <% } else { %>
              <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-light">
                <div class="d-flex align-items-center">
                  <i class="fa-solid fa-shield-halved text-secondary fs-3 me-3"></i>
                  <div>
                    <h6 class="mb-1 fw-bold text-dark">Verified Guest Reviews Only</h6>
                    <p class="mb-0 text-secondary small">To protect authentic feedback, only guests with completed reservations can write a review.</p>
                  </div>
                </div>
              </div>
            <% } %>
          <% } else { %>
            <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-light text-center">
              <p class="mb-0 text-secondary small">
                <i class="fa-solid fa-shield-halved me-1 text-primary"></i>
                Reviews are reserved for verified guests. <a href="/login" class="text-danger fw-semibold">Log in to view eligibility</a>.
              </p>
            </div>
          <% } %>

          <!-- All Reviews List -->
          <% if(listing.reviews && listing.reviews.length > 0){ %>
            <div class="d-flex align-items-center justify-content-between mb-3">
              <h4 class="mb-0 fw-bold">Guest Reviews (<%= listing.reviews.length %>)</h4>
            </div>
            <div class="row g-3">
              <% for(let review of listing.reviews){ %>
                <div class="col-12 col-md-6">
                  <div class="card h-100 review-card p-3 shadow-sm">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                      <div class="d-flex align-items-center gap-2">
                        <div class="wl-avatar-circle" style="width: 38px; height: 38px; font-size: 0.9rem;">
                          <%= review.author ? review.author.username.charAt(0).toUpperCase() : 'A' %>
                        </div>
                        <div>
                          <h6 class="mb-0 fw-bold text-dark small">@<%= review.author ? review.author.username : "Anonymous" %></h6>
                          <% if(review.createdAt) { %>
                            <small class="text-muted" style="font-size: 0.75rem;">
                              <%= new Date(review.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) %>
                            </small>
                          <% } %>
                        </div>
                      </div>
                      <% if (review.isVerifiedGuest || review.booking) { %>
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 small" style="font-size: 0.68rem;">
                          <i class="fa-solid fa-circle-check me-1"></i>Verified Stay
                        </span>
                      <% } %>
                    </div>
                    <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>"></p>
                    <p class="card-text text-secondary small mb-3 flex-grow-1" style="line-height: 1.5;">
                      <%= review.comment %>
                    </p>
                    <% if(currUser && review.author && review.author._id.equals(currUser._id)){ %>
                      <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mt-auto m-0" data-confirm="Are you sure you want to delete your review?">
                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                        <button class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1" style="font-size: 0.78rem;">Delete Review</button>
                      </form>
                    <% } %>
                  </div>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <div class="p-4 bg-white border rounded-4 text-center my-3 shadow-sm">
              <i class="fa-regular fa-star text-muted fs-3 mb-2 d-block"></i>
              <h6 class="fw-semibold text-dark mb-1">No reviews yet</h6>
              <p class="text-secondary small mb-0">Be the first verified guest to review this property after your stay!</p>
            </div>
          <% } %>
        </div>
      </div>

      <!-- Right Column: Sticky Reservation Widget -->
      <div class="col-12 col-lg-5 col-xl-4">
        <div class="wl-reservation-card booking-card shadow-lg p-4">
          <% if (listing.isActive === false) { %>
            <div class="text-center py-4">
              <i class="fa-solid fa-box-archive fa-3x text-secondary mb-3 opacity-75"></i>
              <h5 class="fw-bold mb-2">Listing Archived</h5>
              <p class="text-secondary small mb-0">
                This property is no longer accepting new reservations. Existing bookings remain active.
              </p>
            </div>
          <% } else { %>
            <!-- Price Display Header -->
            <div class="d-flex justify-content-between align-items-baseline mb-3 pb-3 border-bottom">
              <div>
                <span class="fs-3 fw-bold text-dark">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></span>
                <span class="text-secondary small"> / night</span>
              </div>
              <div>
                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1 small">
                  +5% GST
                </span>
              </div>
            </div>

            <!-- Booking Form -->
            <form action="/listings/<%= listing._id %>/bookings" method="POST" id="bookingForm" data-listing-id="<%= listing._id %>" data-price="<%= listing.price || 0 %>" data-tax-rate="<%= (typeof taxConfig !== 'undefined' && taxConfig.GST_PERCENT) ? taxConfig.GST_PERCENT : 5 %>" class="needs-validation" novalidate>
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

              <!-- Date / Time Box -->
              <div class="border rounded-3 p-3 mb-3 bg-light booking-inputs-box">
                <div class="row g-2">
                  <!-- Check-In -->
                  <div class="col-6">
                    <label class="wl-form-label mb-1" style="font-size: 0.72rem;">
                      <i class="fa-regular fa-calendar-plus text-danger me-1"></i>Check-in
                    </label>
                    <input type="date" class="form-control form-control-sm mb-1" id="checkInDate" name="booking[checkInDate]" required />
                    <input type="time" class="form-control form-control-sm" id="checkInTime" name="booking[checkInTime]" value="<%= listing.checkInTime || '14:00' %>" required />
                  </div>

                  <!-- Check-Out -->
                  <div class="col-6">
                    <label class="wl-form-label mb-1" style="font-size: 0.72rem;">
                      <i class="fa-regular fa-calendar-minus text-danger me-1"></i>Check-out
                    </label>
                    <input type="date" class="form-control form-control-sm mb-1" id="checkOutDate" name="booking[checkOutDate]" required />
                    <input type="time" class="form-control form-control-sm" id="checkOutTime" name="booking[checkOutTime]" value="<%= listing.checkOutTime || '11:00' %>" required />
                  </div>
                </div>
              </div>

              <!-- Live validation message banner -->
              <div id="bookingValidationError" class="alert alert-danger py-2 small d-none mb-3 rounded-3" role="alert">
                <i class="fa-solid fa-circle-exclamation me-1"></i><span id="bookingValidationMsg"></span>
              </div>

              <!-- Guests Selector -->
              <div class="mb-3">
                <label for="guests" class="wl-form-label mb-1" style="font-size: 0.75rem;">Number of Guests</label>
                <div class="d-flex align-items-center gap-2">
                  <div class="input-group" style="max-width: 140px;">
                    <button type="button" class="btn btn-outline-secondary px-3" id="decreaseGuests" aria-label="Decrease guests">-</button>
                    <input type="number" class="form-control text-center fw-bold" id="guests" name="booking[guests]" value="2" min="1" max="20" required />
                    <button type="button" class="btn btn-outline-secondary px-3" id="increaseGuests" aria-label="Increase guests">+</button>
                  </div>
                  <span class="text-secondary small">guest(s)</span>
                </div>
              </div>

              <!-- Price Breakdown -->
              <div id="priceBreakdown" class="d-none border-top pt-3 my-3">
                <div class="d-flex justify-content-between align-items-center mb-1 small">
                  <span class="text-secondary" id="priceCalculationText">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %> &times; 0 nights</span>
                  <span class="fw-semibold text-dark" id="calculatedBasePrice">&#8377;0</span>
                </div>
                <div class="d-flex justify-content-between align-items-center mb-2 small">
                  <span class="text-secondary" id="gstLabelText">GST (5%)</span>
                  <span class="fw-semibold text-dark" id="calculatedGstAmount">&#8377;0</span>
                </div>
                <hr class="my-2">
                <div class="d-flex justify-content-between align-items-center fw-bold">
                  <span>Total Due</span>
                  <span class="text-dark fs-5" id="calculatedTotalPrice">&#8377;0</span>
                </div>
              </div>

              <!-- Availability Status Banner -->
              <div id="availabilityStatus" class="alert py-2 px-3 small d-none mb-3 rounded-3" role="status" aria-live="polite">
                <div class="d-flex align-items-center">
                  <span id="availabilitySpinner" class="spinner-border spinner-border-sm me-2 d-none" role="status" aria-hidden="true"></span>
                  <span id="availabilityIcon" class="me-2 d-none"></span>
                  <span id="availabilityMsg" class="fw-semibold"></span>
                </div>
                <div id="availabilityReason" class="small mt-1 d-none"></div>
              </div>

              <!-- Reserve Action Button -->
              <% if (currUser) { %>
                <button type="submit" class="wl-btn wl-btn-primary w-100 py-3 fw-bold rounded-pill add-btn" id="reserveBtn" disabled>
                  Reserve Stay
                </button>
              <% } else { %>
                <a href="/login" class="wl-btn wl-btn-primary w-100 py-3 fw-bold rounded-pill text-center add-btn" id="reserveBtn">
                  Log in to Reserve
                </a>
                <p class="text-muted small text-center mt-2 mb-0">Please sign in to complete your reservation.</p>
              <% } %>
            </form>

            <div class="text-center mt-3">
              <span class="text-muted small" style="font-size: 0.78rem;">
                <i class="fa-solid fa-lock me-1 text-success"></i>You won't be charged yet
              </span>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

  <!-- Leaflet CSS & JS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
  </script>

  <% if (listing.latitude !=null && listing.longitude !=null) { %>
    <script>
      const latitude = parseFloat("<%= listing.latitude %>");
      const longitude = parseFloat("<%= listing.longitude %>");
      const listingTitle = "<%= listing.title %>";
      const listingLocation = "<%= listing.location %>";

      const map = L.map("map", {
        scrollWheelZoom: false
      }).setView([latitude, longitude], 13);

      // World Street Map tile provider (100% free, high-availability CDN, no API keys, no watermarks, no usage blocks)
      L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}", {
        maxZoom: 18,
        attribution: 'Tiles &copy; Esri &mdash; Source: Esri, DeLorme, NAVTEQ, USGS, Intermap, iPC, NRCAN, Esri Japan, METI, Esri China (Hong Kong), Esri (Thailand), TomTom'
      }).addTo(map);

      L.marker([latitude, longitude])
        .addTo(map)
        .bindPopup(`<b>${listingTitle}</b><br><small>${listingLocation}</small><br>Exact location provided after booking.`)
        .openPopup();
    </script>
    <% } else { %>
      <script>
        const mapContainer = document.getElementById("map");
        if (mapContainer) {
          mapContainer.innerHTML = "<p class='text-muted mt-2'>Location map unavailable for this listing.</p>";
          mapContainer.style.height = "auto";
        }
      </script>
      <% } %>

<script>
  (() => {
    const now = new Date();
    const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, "0")}-${String(now.getDate()).padStart(2, "0")}`;

    const bookingForm = document.getElementById("bookingForm");
    const checkInDate = document.getElementById("checkInDate");
    const checkInTime = document.getElementById("checkInTime");
    const checkOutDate = document.getElementById("checkOutDate");
    const checkOutTime = document.getElementById("checkOutTime");
    const guestsInput = document.getElementById("guests");
    const decreaseGuests = document.getElementById("decreaseGuests");
    const increaseGuests = document.getElementById("increaseGuests");

    const reserveBtn = document.getElementById("reserveBtn");
    const availabilityStatus = document.getElementById("availabilityStatus");
    const availabilitySpinner = document.getElementById("availabilitySpinner");
    const availabilityIcon = document.getElementById("availabilityIcon");
    const availabilityMsg = document.getElementById("availabilityMsg");
    const availabilityReason = document.getElementById("availabilityReason");

    const priceBreakdown = document.getElementById("priceBreakdown");
    const priceCalculationText = document.getElementById("priceCalculationText");
    const calculatedBasePrice = document.getElementById("calculatedBasePrice");
    const calculatedGstAmount = document.getElementById("calculatedGstAmount");
    const calculatedTotalPrice = document.getElementById("calculatedTotalPrice");

    const pricePerNight = bookingForm ? parseFloat(bookingForm.dataset.price) || 0 : 0;
    const taxRatePercent = bookingForm ? parseFloat(bookingForm.dataset.taxRate) || 5 : 5;

    let isAvailable = false;
    let checkTimeout = null;
    let currentRequestId = 0;

    // 1. Prevent selecting obviously invalid dates (set HTML5 min bounds)
    if (checkInDate) {
      checkInDate.min = today;
    }
    if (checkOutDate) {
      checkOutDate.min = today;
    }

    function setReserveButtonState(enabled) {
      if (!reserveBtn) return;
      if (reserveBtn.tagName === "BUTTON") {
        reserveBtn.disabled = !enabled;
      } else {
        if (enabled) {
          reserveBtn.classList.remove("disabled");
          reserveBtn.style.pointerEvents = "";
          reserveBtn.style.opacity = "";
        } else {
          reserveBtn.classList.add("disabled");
          reserveBtn.style.pointerEvents = "none";
          reserveBtn.style.opacity = "0.65";
        }
      }
    }

    // Initialize Reserve button disabled until checked & verified available
    setReserveButtonState(false);

    /**
     * Display one of the 4 clear states:
     * - 'checking': Checking availability...
     * - 'available': ✓ Available for these dates
     * - 'unavailable': ✕ This listing is not available for the selected dates. (with reason)
     * - 'invalid': Invalid selection (with reason)
     * - 'error': API/Network error
     */
    function showAvailabilityState(state, message, reason) {
      if (!availabilityStatus || !availabilityMsg) return;

      availabilityStatus.classList.remove("d-none", "alert-info", "alert-success", "alert-danger", "alert-warning");

      if (availabilitySpinner) {
        availabilitySpinner.classList.add("d-none");
      }
      if (availabilityIcon) {
        availabilityIcon.classList.add("d-none");
        availabilityIcon.innerHTML = "";
      }
      if (availabilityReason) {
        availabilityReason.classList.add("d-none");
        availabilityReason.textContent = "";
      }

      if (state === "checking") {
        availabilityStatus.classList.add("alert-info");
        if (availabilitySpinner) {
          availabilitySpinner.classList.remove("d-none");
        }
        availabilityMsg.textContent = message || "Checking availability...";
      } else if (state === "available") {
        availabilityStatus.classList.add("alert-success");
        if (availabilityIcon) {
          availabilityIcon.classList.remove("d-none");
          availabilityIcon.innerHTML = '<i class="fa-solid fa-circle-check text-success"></i>';
        }
        availabilityMsg.textContent = message || "✓ Available for these dates";
        if (reason && availabilityReason) {
          availabilityReason.classList.remove("d-none");
          availabilityReason.textContent = reason;
        }
      } else if (state === "unavailable") {
        availabilityStatus.classList.add("alert-danger");
        if (availabilityIcon) {
          availabilityIcon.classList.remove("d-none");
          availabilityIcon.innerHTML = '<i class="fa-solid fa-circle-xmark text-danger"></i>';
        }
        availabilityMsg.textContent = message || "✕ This listing is not available for the selected dates.";
        if (availabilityReason) {
          availabilityReason.classList.remove("d-none");
          availabilityReason.textContent = reason || "Another reservation overlaps with these dates and times. Please choose different dates or times.";
        }
      } else if (state === "invalid") {
        availabilityStatus.classList.add("alert-warning");
        if (availabilityIcon) {
          availabilityIcon.classList.remove("d-none");
          availabilityIcon.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-warning"></i>';
        }
        availabilityMsg.textContent = "Invalid date/time selection";
        if (availabilityReason) {
          availabilityReason.classList.remove("d-none");
          availabilityReason.textContent = message || reason || "Please verify your selected dates and times.";
        }
      } else if (state === "error") {
        availabilityStatus.classList.add("alert-warning");
        if (availabilityIcon) {
          availabilityIcon.classList.remove("d-none");
          availabilityIcon.innerHTML = '<i class="fa-solid fa-triangle-exclamation text-warning"></i>';
        }
        availabilityMsg.textContent = message || "✕ Unable to check availability.";
        if (reason && availabilityReason) {
          availabilityReason.classList.remove("d-none");
          availabilityReason.textContent = reason;
        }
      } else {
        availabilityStatus.classList.add("d-none");
      }
    }

    function clearAvailabilityState() {
      if (availabilityStatus) {
        availabilityStatus.classList.add("d-none");
        availabilityStatus.classList.remove("alert-info", "alert-success", "alert-danger", "alert-warning");
      }
      if (availabilitySpinner) {
        availabilitySpinner.classList.add("d-none");
      }
      if (availabilityIcon) {
        availabilityIcon.classList.add("d-none");
        availabilityIcon.innerHTML = "";
      }
      if (availabilityMsg) {
        availabilityMsg.textContent = "";
      }
      if (availabilityReason) {
        availabilityReason.classList.add("d-none");
        availabilityReason.textContent = "";
      }
    }

    function parseDateUTC(dateStr) {
      if (!dateStr) return null;
      const parts = dateStr.split("-").map(Number);
      if (parts.length !== 3 || !parts[0] || !parts[1] || !parts[2]) return null;
      return Date.UTC(parts[0], parts[1] - 1, parts[2]);
    }

    function validateAndCalculate() {
      if (!checkInDate || !checkOutDate || !checkInTime || !checkOutTime || !guestsInput) {
        return false;
      }

      // Reset validation error styles
      checkInDate.classList.remove("is-invalid");
      checkOutDate.classList.remove("is-invalid");
      checkInTime.classList.remove("is-invalid");
      checkOutTime.classList.remove("is-invalid");
      guestsInput.classList.remove("is-invalid");

      checkInDate.setCustomValidity("");
      checkOutDate.setCustomValidity("");
      checkInTime.setCustomValidity("");
      checkOutTime.setCustomValidity("");
      guestsInput.setCustomValidity("");

      const inDate = checkInDate.value;
      const inTime = checkInTime.value;
      const outDate = checkOutDate.value;
      const outTime = checkOutTime.value;
      const guests = parseInt(guestsInput.value, 10);

      // Guests validation: at least 1
      if (isNaN(guests) || guests < 1) {
        guestsInput.classList.add("is-invalid");
        guestsInput.setCustomValidity("Guests must be at least 1.");
        showAvailabilityState("invalid", "Number of guests must be at least 1.");
        if (priceBreakdown) priceBreakdown.classList.add("d-none");
        setReserveButtonState(false);
        isAvailable = false;
        return false;
      }

      // If either date is not yet selected, hide price breakdown and return false
      if (!inDate || !outDate) {
        if (priceBreakdown) priceBreakdown.classList.add("d-none");
        clearAvailabilityState();
        setReserveButtonState(false);
        isAvailable = false;
        clearTimeout(checkTimeout);
        currentRequestId++;
        return false;
      }

      // 1. Check-in date cannot be in the past
      if (inDate < today) {
        checkInDate.classList.add("is-invalid");
        checkInDate.setCustomValidity("Check-in date cannot be in the past.");
        showAvailabilityState("invalid", "Check-in date cannot be in the past. Please select today or a future date.");
        if (priceBreakdown) priceBreakdown.classList.add("d-none");
        setReserveButtonState(false);
        isAvailable = false;
        return false;
      }

      // 2. Check-out date must be on or after check-in date
      if (outDate < inDate) {
        checkOutDate.classList.add("is-invalid");
        checkOutDate.setCustomValidity("Check-out date must be on or after check-in date.");
        showAvailabilityState("invalid", "Check-out date must be on or after check-in date.");
        if (priceBreakdown) priceBreakdown.classList.add("d-none");
        setReserveButtonState(false);
        isAvailable = false;
        return false;
      }

      const isSameDay = (outDate === inDate);

      // 3. If check-in and check-out happen on the same date, check-out time must be later than check-in time
      if (isSameDay) {
        if (inTime && outTime && outTime <= inTime) {
          checkOutTime.classList.add("is-invalid");
          checkOutTime.setCustomValidity("For same-day bookings, check-out time must be later than check-in time.");
          showAvailabilityState("invalid", "For same-day stays, check-out time must be later than check-in time.");
          if (priceBreakdown) priceBreakdown.classList.add("d-none");
          setReserveButtonState(false);
          isAvailable = false;
          return false;
        }
      }

      // Calculate stay duration & price breakdown
      const startUTC = parseDateUTC(inDate);
      const endUTC = parseDateUTC(outDate);
      const MS_PER_DAY = 1000 * 60 * 60 * 24;

      let nights = 0;
      let label = "";

      if (isSameDay) {
        nights = 1;
        label = "1 night (same-day stay)";
      } else {
        nights = Math.round((endUTC - startUTC) / MS_PER_DAY);
        label = nights === 1 ? "1 night" : `${nights} nights`;
      }

      if (nights > 0 && priceBreakdown) {
        const basePrice = Math.max(0, nights * pricePerNight);
        const taxRate = Math.max(0, taxRatePercent);
        const gstAmount = Math.round(basePrice * (taxRate / 100));
        const totalPrice = basePrice + gstAmount;

        const formattedPerNight = pricePerNight.toLocaleString("en-IN");
        const formattedBasePrice = basePrice.toLocaleString("en-IN");
        const formattedGstAmount = gstAmount.toLocaleString("en-IN");
        const formattedTotalPrice = totalPrice.toLocaleString("en-IN");

        if (priceCalculationText) {
          priceCalculationText.innerHTML = `&#8377;${formattedPerNight} &times; ${label}`;
        }
        if (calculatedBasePrice) {
          calculatedBasePrice.innerHTML = `&#8377;${formattedBasePrice}`;
        }
        if (calculatedGstAmount) {
          calculatedGstAmount.innerHTML = `&#8377;${formattedGstAmount}`;
        }
        if (calculatedTotalPrice) {
          calculatedTotalPrice.innerHTML = `&#8377;${formattedTotalPrice}`;
        }
        priceBreakdown.classList.remove("d-none");
      }

      return true;
    }

    function triggerAvailabilityCheck() {
      clearTimeout(checkTimeout);
      isAvailable = false;
      setReserveButtonState(false);

      const inDate = checkInDate ? checkInDate.value : "";
      const outDate = checkOutDate ? checkOutDate.value : "";
      const inTime = checkInTime ? checkInTime.value : "";
      const outTime = checkOutTime ? checkOutTime.value : "";

      if (!inDate || !outDate || !inTime || !outTime) {
        clearAvailabilityState();
        return;
      }

      showAvailabilityState("checking", "Checking availability...");

      checkTimeout = setTimeout(() => {
        performAvailabilityCheck();
      }, 250);
    }

    async function performAvailabilityCheck() {
      const reqId = ++currentRequestId;
      const inDate = checkInDate.value;
      const inTime = checkInTime.value;
      const outDate = checkOutDate.value;
      const outTime = checkOutTime.value;
      const listingId = bookingForm ? bookingForm.dataset.listingId : null;

      if (!listingId || !inDate || !outDate || !inTime || !outTime) {
        return;
      }

      try {
        const params = new URLSearchParams({
          checkInDate: inDate,
          checkInTime: inTime,
          checkOutDate: outDate,
          checkOutTime: outTime
        });

        const response = await fetch(`/listings/${listingId}/availability?${params.toString()}`, {
          headers: {
            "Accept": "application/json"
          }
        });

        // Discard stale response if newer request was started
        if (reqId !== currentRequestId) return;

        const data = await response.json();

        if (response.ok && data.available === true) {
          isAvailable = true;
          showAvailabilityState("available", "✓ Available for these dates", "You can proceed with your reservation.");
          setReserveButtonState(true);
        } else if (response.ok && data.available === false) {
          isAvailable = false;
          showAvailabilityState("unavailable", data.message || "✕ This listing is not available for the selected dates.", data.reason || "Another reservation overlaps with these dates and times. Please choose different dates or times.");
          setReserveButtonState(false);
        } else {
          // 4xx or 5xx from server
          isAvailable = false;
          const errMsg = data.message || data.error || "✕ Unable to check availability. Please try again.";
          showAvailabilityState("invalid", errMsg);
          setReserveButtonState(false);
        }
      } catch (err) {
        if (reqId !== currentRequestId) return;
        isAvailable = false;
        showAvailabilityState("error", "✕ Unable to check availability. Please check your connection and try again.");
        setReserveButtonState(false);
      }
    }

    // 5. Handle repeated changes: reset previous availability and require fresh check
    function handleInputChange() {
      // Immediately invalidate previous availability state on any input change
      isAvailable = false;
      setReserveButtonState(false);
      clearTimeout(checkTimeout);
      currentRequestId++;

      const inDate = checkInDate ? checkInDate.value : "";
      const outDate = checkOutDate ? checkOutDate.value : "";

      // Enforce checkout minimum date dynamically
      if (inDate && checkOutDate) {
        checkOutDate.min = inDate;
      }

      const isValid = validateAndCalculate();

      if (isValid && inDate && outDate) {
        // Valid date/time selection: trigger backend Availability API check
        triggerAvailabilityCheck();
      } else if (!inDate || !outDate) {
        clearAvailabilityState();
      }
    }

    // Listen to both 'change' and 'input' on all date and time inputs for immediate reactivity
    ["change", "input"].forEach((evt) => {
      if (checkInDate) {
        checkInDate.addEventListener(evt, () => {
          if (checkInDate.value) {
            checkOutDate.min = checkInDate.value;
            if (checkOutDate.value && checkOutDate.value < checkInDate.value) {
              checkOutDate.value = checkInDate.value;
            }
          }
          handleInputChange();
        });
      }

      if (checkOutDate) {
        checkOutDate.addEventListener(evt, () => {
          handleInputChange();
        });
      }

      if (checkInTime) {
        checkInTime.addEventListener(evt, () => {
          handleInputChange();
        });
      }

      if (checkOutTime) {
        checkOutTime.addEventListener(evt, () => {
          handleInputChange();
        });
      }
    });

    if (guestsInput && decreaseGuests && increaseGuests) {
      decreaseGuests.addEventListener("click", () => {
        let val = parseInt(guestsInput.value, 10) || 1;
        if (val > 1) {
          guestsInput.value = val - 1;
        }
        handleInputChange();
      });

      increaseGuests.addEventListener("click", () => {
        let val = parseInt(guestsInput.value, 10) || 1;
        guestsInput.value = val + 1;
        handleInputChange();
      });

      guestsInput.addEventListener("input", () => {
        let val = parseInt(guestsInput.value, 10);
        if (isNaN(val) || val < 1) {
          guestsInput.value = 1;
        }
        handleInputChange();
      });
    }

    if (bookingForm) {
      bookingForm.addEventListener("submit", (e) => {
        const isValid = validateAndCalculate();
        if (!isValid || !isAvailable || !bookingForm.checkValidity()) {
          e.preventDefault();
          e.stopPropagation();
          if (!isAvailable) {
            if (!checkInDate.value || !checkOutDate.value) {
              showAvailabilityState("invalid", "Please select both check-in and check-out dates.");
            } else {
              showAvailabilityState("invalid", "Please select available dates before reserving.");
            }
          }
          return;
        }
        bookingForm.classList.add("was-validated");
      });
    }

    // Run check on initial load in case inputs are pre-filled
    if (checkInDate && checkInDate.value && checkOutDate && checkOutDate.value) {
      handleInputChange();
    }
  })();

  // Wishlist Flying Heart Controller & AJAX Toggle
  (() => {
    const wishlistForm = document.getElementById("showWishlistForm");
    const wishlistBtn = document.getElementById("showWishlistBtn");
    if (!wishlistForm || !wishlistBtn) return;

    let isBusy = false;

    wishlistForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (isBusy) return;
      isBusy = true;

      const heartBox = wishlistBtn.querySelector(".wishlist-heart-box");
      const btnText = wishlistBtn.querySelector(".wishlist-btn-text");
      const isCurrentlySaved = wishlistBtn.classList.contains("is-saved");
      const listingId = wishlistForm.dataset.listingId;
      const csrfInput = wishlistForm.querySelector('input[name="_csrf"]');
      const csrfToken = csrfInput ? csrfInput.value : "";

      // Target: Navbar Wishlist Icon
      const navTarget = document.getElementById("navbarWishlistIcon") || document.getElementById("navbarWishlistLink");

      // If adding to wishlist, animate flying heart across screen to navbar!
      if (!isCurrentlySaved && navTarget) {
        const startRect = heartBox ? heartBox.getBoundingClientRect() : wishlistBtn.getBoundingClientRect();
        const targetRect = navTarget.getBoundingClientRect();

        const startX = startRect.left + startRect.width / 2;
        const startY = startRect.top + startRect.height / 2;
        const endX = targetRect.left + targetRect.width / 2;
        const endY = targetRect.top + targetRect.height / 2;

        const deltaX = endX - startX;
        const deltaY = endY - startY;

        // Create flying heart element
        const flyingHeart = document.createElement("div");
        flyingHeart.className = "wl-flying-heart";
        flyingHeart.innerHTML = '<i class="fa-solid fa-heart"></i>';
        flyingHeart.style.left = `${startX - 12}px`;
        flyingHeart.style.top = `${startY - 12}px`;
        document.body.appendChild(flyingHeart);

        // Animate flying heart with dynamic parabolic curve
        const duration = 750;
        const startTime = performance.now();

        const animateFlight = (currentTime) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);

          // Easing progress (smooth cubic out)
          const easeProgress = 1 - Math.pow(1 - progress, 3);
          const currentX = deltaX * easeProgress;
          // Arc upward curve (fly upward like an arc)
          const arcPeak = -80 * Math.sin(progress * Math.PI);
          const currentY = deltaY * easeProgress + arcPeak;

          // Dynamic scale and rotation during flight
          const scale = progress < 0.3 ? 1 + progress * 1.5 : 1.45 - (progress - 0.3) * 1.3;
          const rotate = Math.sin(progress * Math.PI * 2) * 20;
          const opacity = progress > 0.85 ? (1 - progress) / 0.15 : 1;

          flyingHeart.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) scale(${scale}) rotate(${rotate}deg)`;
          flyingHeart.style.opacity = opacity;

          if (progress < 1) {
            requestAnimationFrame(animateFlight);
          } else {
            flyingHeart.remove();

            // Navbar heart celebration pulse
            navTarget.classList.remove("wl-heart-pulse");
            void navTarget.offsetWidth; // Trigger DOM reflow
            navTarget.classList.add("wl-heart-pulse");

            // Golden ripple particle effect
            const ripple = document.createElement("div");
            ripple.className = "wl-sparkle-ripple";
            ripple.style.left = `${endX - 16}px`;
            ripple.style.top = `${endY - 16}px`;
            document.body.appendChild(ripple);
            setTimeout(() => ripple.remove(), 600);
          }
        };

        requestAnimationFrame(animateFlight);
      }

      // Immediate visual update on button
      if (!isCurrentlySaved) {
        wishlistBtn.classList.add("is-saved");
        wishlistBtn.title = "Remove from Wishlist";
        if (heartBox) heartBox.innerHTML = '<i class="fa-solid fa-heart wishlist-heart-icon wishlist-heart-filled"></i>';
        if (btnText) btnText.textContent = "Saved";
      } else {
        wishlistBtn.classList.remove("is-saved");
        wishlistBtn.title = "Save to Wishlist";
        if (heartBox) heartBox.innerHTML = '<i class="fa-regular fa-heart wishlist-heart-icon wishlist-heart-empty"></i>';
        if (btnText) btnText.textContent = "Save";
      }

      // Send AJAX request
      try {
        const response = await fetch(`/listings/${listingId}/wishlist`, {
          method: "POST",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded",
            "Accept": "application/json"
          },
          body: new URLSearchParams({ _csrf: csrfToken })
        });

        if (response.redirected) {
          window.location.href = response.url;
          return;
        }

        if (response.status === 401 || response.status === 403) {
          window.location.href = "/login";
          return;
        }

        const data = await response.json();
        if (data && data.success) {
          if (data.isWishlisted) {
            wishlistBtn.classList.add("is-saved");
            wishlistBtn.title = "Remove from Wishlist";
            if (heartBox) heartBox.innerHTML = '<i class="fa-solid fa-heart wishlist-heart-icon wishlist-heart-filled"></i>';
            if (btnText) btnText.textContent = "Saved";
          } else {
            wishlistBtn.classList.remove("is-saved");
            wishlistBtn.title = "Save to Wishlist";
            if (heartBox) heartBox.innerHTML = '<i class="fa-regular fa-heart wishlist-heart-icon wishlist-heart-empty"></i>';
            if (btnText) btnText.textContent = "Save";
          }
        }
      } catch (err) {
        console.error("Wishlist AJAX error:", err);
        wishlistForm.submit();
      } finally {
        setTimeout(() => { isBusy = false; }, 350);
      }
    });
  })();
</script>