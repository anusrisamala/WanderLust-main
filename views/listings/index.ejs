<% layout("/layouts/boilerplate") %>

<%
  const currentSearch = (typeof searchQuery !== "undefined" && searchQuery) ? searchQuery : "";
  const currentCategory = (typeof category !== "undefined" && category) ? category : "";

  function getFilterUrl(catName) {
    if (!catName) {
      return currentSearch ? `/listings/search?q=${encodeURIComponent(currentSearch)}` : '/listings';
    }
    return currentSearch 
      ? `/listings/search?q=${encodeURIComponent(currentSearch)}&category=${encodeURIComponent(catName)}`
      : `/listings?category=${encodeURIComponent(catName)}`;
  }
%>

<!-- Category Filters & Tax Toggle Bar -->
<div class="wl-filters-bar">
  <div class="wl-category-track" id="filters">
    <a href="<%= getFilterUrl('') %>" class="wl-category-chip <%= !currentCategory ? 'active' : '' %>">
      <i class="fa-solid fa-compass"></i>
      <span>All Stays</span>
    </a>
    <a href="<%= getFilterUrl('Trending') %>" class="wl-category-chip <%= currentCategory === 'Trending' ? 'active' : '' %>">
      <i class="fa-solid fa-fire"></i>
      <span>Trending</span>
    </a>
    <a href="<%= getFilterUrl('Rooms') %>" class="wl-category-chip <%= currentCategory === 'Rooms' ? 'active' : '' %>">
      <i class="fa-solid fa-bed"></i>
      <span>Rooms</span>
    </a>
    <a href="<%= getFilterUrl('Iconic Cities') %>" class="wl-category-chip <%= currentCategory === 'Iconic Cities' ? 'active' : '' %>">
      <i class="fa-solid fa-city"></i>
      <span>Iconic Cities</span>
    </a>
    <a href="<%= getFilterUrl('Mountains') %>" class="wl-category-chip <%= currentCategory === 'Mountains' ? 'active' : '' %>">
      <i class="fa-solid fa-mountain-sun"></i>
      <span>Mountains</span>
    </a>
    <a href="<%= getFilterUrl('Castles') %>" class="wl-category-chip <%= currentCategory === 'Castles' ? 'active' : '' %>">
      <i class="fa-solid fa-chess-rook"></i>
      <span>Castles</span>
    </a>
    <a href="<%= getFilterUrl('Amazing Pools') %>" class="wl-category-chip <%= currentCategory === 'Amazing Pools' ? 'active' : '' %>">
      <i class="fa-solid fa-water-ladder"></i>
      <span>Villas & Pools</span>
    </a>
    <a href="<%= getFilterUrl('Camping') %>" class="wl-category-chip <%= currentCategory === 'Camping' ? 'active' : '' %>">
      <i class="fa-solid fa-campground"></i>
      <span>Camping</span>
    </a>
    <a href="<%= getFilterUrl('Farms') %>" class="wl-category-chip <%= currentCategory === 'Farms' ? 'active' : '' %>">
      <i class="fa-solid fa-wheat-awn"></i>
      <span>Countryside</span>
    </a>
    <a href="<%= getFilterUrl('Arctic') %>" class="wl-category-chip <%= currentCategory === 'Arctic' ? 'active' : '' %>">
      <i class="fa-solid fa-snowflake"></i>
      <span>Arctic</span>
    </a>
    <a href="<%= getFilterUrl('Domes') %>" class="wl-category-chip <%= currentCategory === 'Domes' ? 'active' : '' %>">
      <i class="fa-solid fa-igloo"></i>
      <span>Domes</span>
    </a>
    <a href="<%= getFilterUrl('Boats') %>" class="wl-category-chip <%= currentCategory === 'Boats' ? 'active' : '' %>">
      <i class="fa-solid fa-sailboat"></i>
      <span>Houseboats</span>
    </a>
  </div>

  <!-- Tax Toggle Capsule -->
  <div class="wl-tax-toggle tax-toggle">
    <div class="form-check form-switch mb-0 d-flex align-items-center gap-2">
      <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
      <label class="form-check-label mb-0" for="flexSwitchCheckDefault">Display total with taxes</label>
    </div>
  </div>
</div>

<!-- Search & Filter Summary Banner -->
<% if (currentSearch && currentCategory) { %>
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h5 class="fw-bold mb-0">Results for "<%= currentSearch %>" in <span style="color: var(--wl-secondary);"><%= currentCategory %></span></h5>
    <a href="/listings" class="wl-btn wl-btn-outline wl-btn-sm"><i class="fa-solid fa-xmark me-1"></i> Clear Filters</a>
  </div>
<% } else if (currentSearch) { %>
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h5 class="fw-bold mb-0">Destinations matching "<%= currentSearch %>"</h5>
    <a href="/listings" class="wl-btn wl-btn-outline wl-btn-sm"><i class="fa-solid fa-xmark me-1"></i> Clear Search</a>
  </div>
<% } else if (currentCategory) { %>
  <div class="d-flex align-items-center justify-content-between mb-4">
    <h5 class="fw-bold mb-0"><%= currentCategory %> Collection</h5>
    <a href="/listings" class="wl-btn wl-btn-outline wl-btn-sm"><i class="fa-solid fa-xmark me-1"></i> All Categories</a>
  </div>
<% } %>

<!-- Listings Grid -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
  <% if (allListings.length === 0) { %>
    <div class="col-12 py-5">
      <div class="wl-form-card text-center py-5">
        <div class="mb-3 text-muted">
          <i class="fa-solid fa-map-location-dot fs-1" style="color: var(--wl-secondary);"></i>
        </div>
        <h4 class="fw-bold mb-2">No Stays Found</h4>
        <% if (currentSearch && currentCategory) { %>
          <p class="text-muted mb-4">We couldn't find any stays matching "<strong><%= currentSearch %></strong>" in <strong><%= currentCategory %></strong>.</p>
        <% } else if (currentSearch) { %>
          <p class="text-muted mb-4">No destinations found for "<strong><%= currentSearch %></strong>". Try alternative keywords or broader locations.</p>
        <% } else if (currentCategory) { %>
          <p class="text-muted mb-4">There are currently no active listings under the <strong><%= currentCategory %></strong> category.</p>
        <% } else { %>
          <p class="text-muted mb-4">No accommodations are available at the moment. Please check back soon.</p>
        <% } %>
        <div class="d-flex justify-content-center gap-3">
          <a href="/listings" class="wl-btn wl-btn-primary">Browse All Stays</a>
          <% if (typeof currUser !== "undefined" && currUser && currUser.role === "HOST") { %>
            <a href="/listings/new" class="wl-btn wl-btn-outline">List a Stay Here</a>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <% for(let listing of allListings) { %>
    <div class="col">
      <div class="card listing-card wl-listing-card h-100">
        <!-- Media Container -->
        <div class="wl-card-media">
          <a href="/listings/<%= listing._id %>" class="listing-link">
            <img 
              src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e' %>" 
              class="card-img-top" 
              alt="<%= listing.title %>"
              loading="lazy"
            />
          </a>
          
          <% if (listing.category) { %>
            <span class="wl-card-badge"><%= listing.category %></span>
          <% } %>

          <!-- Wishlist Heart Button -->
          <% if (typeof currUser !== 'undefined' && currUser) { %>
            <% const isInWishlist = typeof wishlistListingIds !== 'undefined' && wishlistListingIds.includes(listing._id.toString()); %>
            <form action="/wishlist/toggle/<%= listing._id %>" method="POST" class="d-inline">
              <button type="submit" class="wishlist-floating-btn" title="<%= isInWishlist ? 'Remove from Wishlist' : 'Add to Wishlist' %>" aria-label="Wishlist">
                <i class="fa-solid fa-heart <%= isInWishlist ? 'wishlist-heart-filled' : 'wishlist-heart-empty' %>"></i>
              </button>
            </form>
          <% } %>
        </div>

        <!-- Card Body -->
        <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none">
          <div class="wl-card-content">
            <div class="wl-card-header-row">
              <h3 class="wl-card-title"><%= listing.title %></h3>
            </div>
            
            <div class="wl-card-location">
              <i class="fa-solid fa-location-dot me-1 small" style="color: var(--wl-secondary);"></i>
              <span><%= listing.location %>, <%= listing.country %></span>
            </div>

            <div class="wl-card-pricing">
              <div>
                <span class="wl-card-rate">&#8377;<%= listing.price?.toLocaleString("en-IN") || "0" %></span>
                <span class="wl-card-rate-period">/ night</span>
                <i class="tax-info">&nbsp; &nbsp; +5% GST</i>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>
  <% } %>
</div>

<!-- Tax Display Toggle Script -->
<script>
  (() => {
    const taxSwitch = document.getElementById("flexSwitchCheckDefault");
    if (!taxSwitch) return;
    
    taxSwitch.addEventListener("change", () => {
      const taxInfos = document.querySelectorAll(".tax-info");
      taxInfos.forEach(info => {
        info.style.display = taxSwitch.checked ? "inline" : "none";
      });
    });
  })();
</script>