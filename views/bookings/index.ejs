<% layout("/layouts/boilerplate") %>

<%
  const activeStatus = (typeof currentStatus !== "undefined" && currentStatus) ? currentStatus : "ALL";
  const counts = (typeof statusCounts !== "undefined" && statusCounts) ? statusCounts : {
    ALL: (bookings ? bookings.length : 0),
    CONFIRMED: 0,
    PENDING: 0,
    COMPLETED: 0,
    REFUNDED: 0,
    CANCELLED: 0
  };
%>

<div class="row mt-3 mb-4">
  <div class="col-12">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
      <div>
        <h3 class="fw-bold mb-1">
          <i class="fa-solid fa-calendar-days text-danger me-2"></i>My Trips &amp; Bookings
        </h3>
        <p class="text-secondary small mb-0">
          Track upcoming stays, review booking confirmations, and manage your travel itineraries.
        </p>
      </div>
      <div>
        <a href="/listings" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill">
          <i class="fa-solid fa-magnifying-glass me-1"></i>Explore More Places
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Filter Pills / Tabs -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
    <div class="d-flex flex-wrap gap-2 align-items-center">
      <span class="fw-bold small text-uppercase text-secondary me-1" style="font-size: 0.72rem;">
        <i class="fa-solid fa-filter me-1 text-danger"></i>Status:
      </span>
      <a href="/bookings" class="wl-btn wl-btn-sm wl-btn-pill <%= activeStatus === 'ALL' ? 'wl-btn-dark' : 'wl-btn-outline' %>">
        All <span class="badge <%= activeStatus === 'ALL' ? 'bg-light text-dark' : 'bg-secondary text-white' %> ms-1"><%= counts.ALL %></span>
      </a>
      <a href="/bookings?status=CONFIRMED" class="wl-btn wl-btn-sm wl-btn-pill <%= activeStatus === 'CONFIRMED' ? 'btn-success text-white' : 'wl-btn-outline' %>">
        <i class="fa-solid fa-circle-check me-1"></i>Confirmed
        <span class="badge <%= activeStatus === 'CONFIRMED' ? 'bg-light text-dark' : 'bg-secondary text-white' %> ms-1"><%= counts.CONFIRMED %></span>
      </a>
      <a href="/bookings?status=PENDING" class="wl-btn wl-btn-sm wl-btn-pill <%= activeStatus === 'PENDING' ? 'btn-warning text-dark' : 'wl-btn-outline' %>">
        <i class="fa-regular fa-clock me-1"></i>Pending
        <span class="badge <%= activeStatus === 'PENDING' ? 'bg-dark text-white' : 'bg-secondary text-white' %> ms-1"><%= counts.PENDING %></span>
      </a>
      <a href="/bookings?status=COMPLETED" class="wl-btn wl-btn-sm wl-btn-pill <%= activeStatus === 'COMPLETED' ? 'btn-info text-dark' : 'wl-btn-outline' %>">
        <i class="fa-solid fa-flag-checkered me-1"></i>Completed
        <span class="badge <%= activeStatus === 'COMPLETED' ? 'bg-dark text-white' : 'bg-secondary text-white' %> ms-1"><%= counts.COMPLETED %></span>
      </a>
      <a href="/bookings?status=REFUNDED" class="wl-btn wl-btn-sm wl-btn-pill <%= activeStatus === 'REFUNDED' ? 'btn-secondary text-white' : 'wl-btn-outline' %>">
        <i class="fa-solid fa-rotate-left me-1"></i>Refunded
        <span class="badge <%= activeStatus === 'REFUNDED' ? 'bg-light text-dark' : 'bg-dark text-white' %> ms-1"><%= counts.REFUNDED %></span>
      </a>
      <a href="/bookings?status=CANCELLED" class="wl-btn wl-btn-sm wl-btn-pill <%= activeStatus === 'CANCELLED' ? 'btn-danger text-white' : 'wl-btn-outline' %>">
        <i class="fa-solid fa-ban me-1"></i>Cancelled
        <span class="badge <%= activeStatus === 'CANCELLED' ? 'bg-light text-dark' : 'bg-secondary text-white' %> ms-1"><%= counts.CANCELLED %></span>
      </a>
    </div>
    <div class="text-secondary small">
      Showing <strong><%= bookings ? bookings.length : 0 %></strong> <%= (activeStatus === 'ALL') ? 'total' : activeStatus.toLowerCase() %> <%= bookings && bookings.length === 1 ? 'trip' : 'trips' %>
    </div>
  </div>
</div>

<% if (!bookings || bookings.length === 0) { %>
  <div class="row my-5">
    <div class="col-12 text-center">
      <div class="empty-state-card">
        <i class="fa-regular fa-calendar-xmark empty-state-icon"></i>
        <h4 class="fw-bold mb-2">No <%= activeStatus !== 'ALL' ? activeStatus.toLowerCase() + ' ' : '' %>trips found</h4>
        <p class="text-secondary small mb-4" style="max-width: 440px; margin: 0 auto;">
          <% if (activeStatus !== 'ALL') { %>
            You do not currently have any reservations with status <strong><%= activeStatus %></strong>.
          <% } else { %>
            When you book an escape, your tickets, dates, and check-in details will appear right here.
          <% } %>
        </p>
        <% if (activeStatus !== 'ALL') { %>
          <a href="/bookings" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill px-4">
            <i class="fa-solid fa-rotate-left me-1"></i>View All Trips
          </a>
        <% } else { %>
          <a href="/listings" class="wl-btn wl-btn-primary wl-btn-sm wl-btn-pill px-4">
            <i class="fa-solid fa-compass me-1"></i>Explore Destinations
          </a>
        <% } %>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    <% for (let booking of bookings) { %>
      <div class="col">
        <div class="card h-100 wl-card wl-card-hover bg-white overflow-hidden d-flex flex-column">
          <!-- Thumbnail & Status Overlay -->
          <div class="position-relative" style="height: 190px; overflow: hidden; background: #f1f5f9;">
            <img
              src="<%= (booking.listing && booking.listing.image && booking.listing.image.url) ? booking.listing.image.url : '/images/default.jpg' %>"
              class="w-100 h-100 object-fit-cover"
              alt="<%= booking.listing ? booking.listing.title : 'Stay' %>"
            />
            <div class="position-absolute top-0 end-0 m-3 d-flex flex-column align-items-end gap-1">
              <% if (booking.status === "CONFIRMED") { %>
                <span class="badge bg-success text-white px-3 py-1 rounded-pill shadow-sm small fw-semibold">
                  <i class="fa-solid fa-circle-check me-1"></i>Confirmed
                </span>
              <% } else if (booking.status === "AWAITING_HOST_APPROVAL") { %>
                <span class="badge bg-primary text-white px-3 py-1 rounded-pill shadow-sm small fw-semibold">
                  <i class="fa-solid fa-clock-rotate-left me-1"></i>Awaiting Host
                </span>
              <% } else if (booking.status === "PENDING_PAYMENT" || booking.status === "PENDING") { %>
                <span class="badge bg-warning text-dark px-3 py-1 rounded-pill shadow-sm small fw-semibold">
                  <i class="fa-regular fa-clock me-1"></i>Awaiting Payment
                </span>
              <% } else if (booking.status === "COMPLETED") { %>
                <span class="badge bg-secondary text-white px-3 py-1 rounded-pill shadow-sm small fw-semibold">
                  <i class="fa-solid fa-flag-checkered me-1"></i>Completed
                </span>
              <% } else if (booking.status === "CANCELLED") { %>
                <span class="badge bg-danger text-white px-3 py-1 rounded-pill shadow-sm small fw-semibold">
                  <i class="fa-solid fa-ban me-1"></i>Cancelled
                </span>
              <% } %>
            </div>
          </div>

          <!-- Card Content -->
          <div class="card-body p-3 d-flex flex-column justify-content-between flex-grow-1">
            <div>
              <h5 class="fw-bold mb-1 text-truncate" title="<%= booking.listing ? booking.listing.title : 'Listing' %>">
                <%= booking.listing ? booking.listing.title : 'Listing Details' %>
              </h5>
              <p class="text-secondary small mb-3">
                <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                <%= booking.listing ? `${booking.listing.location}, ${booking.listing.country}` : 'Location unavailable' %>
              </p>

              <!-- Dates & Stay Details -->
              <div class="bg-light rounded-3 p-2 mb-3 small border">
                <div class="d-flex justify-content-between mb-1">
                  <span class="text-muted"><i class="fa-regular fa-calendar me-1"></i>Check-in:</span>
                  <span class="fw-semibold text-dark"><%= booking.checkInDate ? new Date(booking.checkInDate).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) : 'N/A' %></span>
                </div>
                <div class="d-flex justify-content-between mb-1">
                  <span class="text-muted"><i class="fa-regular fa-calendar-check me-1"></i>Check-out:</span>
                  <span class="fw-semibold text-dark"><%= booking.checkOutDate ? new Date(booking.checkOutDate).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) : 'N/A' %></span>
                </div>
                <div class="d-flex justify-content-between">
                  <span class="text-muted"><i class="fa-solid fa-users me-1"></i>Guests:</span>
                  <span class="fw-semibold text-dark"><%= booking.guests || 1 %> <%= booking.guests === 1 ? 'guest' : 'guests' %></span>
                </div>
              </div>
            </div>

            <div>
              <div class="d-flex justify-content-between align-items-baseline pt-2 border-top mb-3">
                <span class="text-secondary small">Total Paid/Due:</span>
                <span class="fs-5 fw-bold text-dark">
                  &#8377;<%= (booking.totalPrice ? (booking.isPaise ? booking.totalPrice / 100 : booking.totalPrice) : 0).toLocaleString("en-IN") %>
                </span>
              </div>

              <div class="d-flex gap-2">
                <a href="/bookings/<%= booking._id %>" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill flex-grow-1">
                  <i class="fa-regular fa-eye me-1"></i>View Details
                </a>
                <% if ((booking.status === "PENDING_PAYMENT" || booking.status === "PENDING") && booking.paymentStatus !== "PAID") { %>
                  <a href="/bookings/<%= booking._id %>/payment" class="wl-btn wl-btn-primary wl-btn-sm wl-btn-pill">
                    <i class="fa-solid fa-credit-card me-1"></i>Pay Now
                  </a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>
<% } %>
