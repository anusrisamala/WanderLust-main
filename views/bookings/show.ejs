<% layout("/layouts/boilerplate") %>
<%
  const toRupees = (amt) => (booking && booking.isPaise ? (amt || 0) / 100 : (amt || 0));
  const displayPricePerNight = booking.pricePerNight != null ? toRupees(booking.pricePerNight) : (booking.listing ? booking.listing.price : 0);
  const displayBasePrice = booking.basePrice != null ? toRupees(booking.basePrice) : toRupees(booking.totalPrice);
  const displayTaxAmount = toRupees(booking.taxAmount);
  const displayTotalPrice = toRupees(booking.totalPrice);
%>

<div class="row mt-3 mb-5 justify-content-center">
  <div class="col-12 col-lg-9">
    <!-- Breadcrumbs -->
    <div class="d-flex justify-content-between align-items-center mb-3">
      <a href="/bookings" class="wl-btn wl-btn-ghost wl-btn-sm wl-btn-pill">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to My Trips
      </a>
      <span class="badge bg-light text-secondary border small">
        <i class="fa-solid fa-receipt me-1 text-primary"></i>Booking #<%= booking._id %>
      </span>
    </div>

    <!-- Main Container Card -->
    <div class="card wl-card border-0 shadow-sm p-4 p-md-5 bg-white">
      <!-- Status Header -->
      <div class="text-center mb-4 pb-4 border-bottom">
        <% if (booking.status === 'CONFIRMED') { %>
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 text-success mb-3" style="width: 64px; height: 64px;">
            <i class="fa-solid fa-circle-check fs-2"></i>
          </div>
          <h2 class="fw-bold mb-1 text-dark">Reservation Confirmed!</h2>
          <p class="text-success fw-semibold small mb-2">
            Pack your bags! Your stay is confirmed and your dates are reserved.
          </p>
        <% } else if (booking.status === 'AWAITING_HOST_APPROVAL' || (booking.status === 'PENDING' && booking.paymentStatus === 'PAID')) { %>
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary mb-3" style="width: 64px; height: 64px;">
            <i class="fa-solid fa-hourglass-half fs-2"></i>
          </div>
          <h2 class="fw-bold mb-1 text-dark">Awaiting Host Confirmation</h2>
          <p class="text-primary fw-semibold small mb-2">
            Payment captured. The host has been notified to review your reservation.
          </p>
        <% } else if (booking.status === 'PENDING_PAYMENT' || (booking.status === 'PENDING' && booking.paymentStatus !== 'PAID')) { %>
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-10 text-warning mb-3" style="width: 64px; height: 64px;">
            <i class="fa-regular fa-clock fs-2"></i>
          </div>
          <h2 class="fw-bold mb-1 text-dark">Booking Pending (Awaiting Payment)</h2>
          <p class="text-secondary fw-semibold small mb-2">
            Please complete checkout within 15 minutes to secure your dates.
          </p>
        <% } else if (booking.status === 'COMPLETED') { %>
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-secondary bg-opacity-10 text-secondary mb-3" style="width: 64px; height: 64px;">
            <i class="fa-solid fa-flag-checkered fs-2"></i>
          </div>
          <h2 class="fw-bold mb-1 text-dark">Trip Completed</h2>
          <p class="text-secondary fw-semibold small mb-3">
            We hope you had an unforgettable experience!
          </p>
          <% if (booking.listing) { %>
            <div>
              <a href="/listings/<%= booking.listing._id || booking.listing %>#reviews" class="wl-btn wl-btn-primary wl-btn-sm wl-btn-pill px-4">
                <i class="fa-solid fa-star me-1 text-warning"></i>Leave a Verified Review
              </a>
            </div>
          <% } %>
        <% } else if (booking.status === 'CANCELLED') { %>
          <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 text-danger mb-3" style="width: 64px; height: 64px;">
            <i class="fa-solid fa-ban fs-2"></i>
          </div>
          <h2 class="fw-bold mb-1 text-dark">Reservation Cancelled</h2>
          <p class="text-danger fw-semibold small mb-2">
            This reservation has been cancelled.
          </p>
        <% } %>

        <div class="d-flex justify-content-center gap-2 flex-wrap mt-2">
          <span class="badge <%= booking.status === 'CONFIRMED' ? 'bg-success' : (booking.status === 'CANCELLED' ? 'bg-danger' : (booking.status === 'COMPLETED' ? 'bg-secondary' : (booking.status === 'AWAITING_HOST_APPROVAL' ? 'bg-primary' : 'bg-warning text-dark'))) %> px-3 py-2 rounded-pill small fw-semibold">
            Status: <%= (booking.status === 'AWAITING_HOST_APPROVAL') ? 'Awaiting Host Approval' : ((booking.status === 'PENDING_PAYMENT') ? 'Awaiting Payment' : booking.status) %>
          </span>
          <% if (booking.paymentStatus === "PAID") { %>
            <span class="badge bg-success px-3 py-2 rounded-pill small fw-semibold">
              <i class="fa-solid fa-circle-check me-1"></i>Payment: PAID
            </span>
          <% } else if (booking.paymentStatus === "REFUND_PENDING") { %>
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill small fw-semibold">
              <i class="fa-solid fa-spinner fa-spin me-1"></i>Payment: REFUND PENDING
            </span>
          <% } else if (booking.paymentStatus === "FAILED") { %>
            <span class="badge bg-danger px-3 py-2 rounded-pill small fw-semibold">
              <i class="fa-solid fa-circle-xmark me-1"></i>Payment: FAILED
            </span>
          <% } else if (booking.paymentStatus === "REFUNDED") { %>
            <span class="badge bg-secondary px-3 py-2 rounded-pill small fw-semibold">
              <i class="fa-solid fa-rotate-left me-1"></i>Payment: REFUNDED
            </span>
          <% } else { %>
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill small fw-semibold">
              <i class="fa-solid fa-hourglass-half me-1"></i>Payment: PENDING
            </span>
          <% } %>
        </div>
      </div>

      <!-- Listing Information Box -->
      <div class="card mb-4 border shadow-none bg-light rounded-4 p-3">
        <div class="row g-3 align-items-center">
          <% if (booking.listing && booking.listing.image && booking.listing.image.url) { %>
            <div class="col-12 col-sm-4">
              <img
                src="<%= booking.listing.image.url %>"
                class="img-fluid rounded-3 w-100 object-fit-cover"
                style="height: 120px;"
                alt="<%= booking.listing.title %>"
              />
            </div>
          <% } %>
          <div class="col-12 <%= (booking.listing && booking.listing.image && booking.listing.image.url) ? 'col-sm-8' : 'col-12' %>">
            <small class="text-secondary text-uppercase fw-bold" style="font-size: 0.72rem;">Property</small>
            <h5 class="fw-bold mb-1 text-dark"><%= booking.listing ? booking.listing.title : "Listing Details" %></h5>
            <p class="text-secondary small mb-2">
              <i class="fa-solid fa-location-dot me-1 text-danger"></i>
              <%= booking.listing ? `${booking.listing.location}, ${booking.listing.country}` : 'Location unavailable' %>
            </p>
            <p class="mb-0 text-dark small">
              <strong>Rate:</strong> &#8377;<%= displayPricePerNight.toLocaleString("en-IN") %> / night
            </p>
          </div>
        </div>
      </div>

      <!-- Stay Timeline Grid -->
      <h6 class="fw-bold mb-3 text-dark text-uppercase small" style="letter-spacing: 0.04em;">Trip Itinerary</h6>
      <div class="row g-3 mb-4 bg-light rounded-4 p-3 mx-0 border">
        <div class="col-6 col-md-3">
          <small class="text-secondary d-block font-monospace">CHECK-IN</small>
          <span class="fw-bold fs-6 text-dark"><%= new Date(booking.checkInDate || booking.checkIn).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) %></span>
          <% if (booking.checkInTime) { %>
            <small class="text-muted d-block"><i class="fa-regular fa-clock me-1"></i><%= booking.checkInTime %></small>
          <% } %>
        </div>
        <div class="col-6 col-md-3">
          <small class="text-secondary d-block font-monospace">CHECK-OUT</small>
          <span class="fw-bold fs-6 text-dark"><%= new Date(booking.checkOutDate || booking.checkOut).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) %></span>
          <% if (booking.checkOutTime) { %>
            <small class="text-muted d-block"><i class="fa-regular fa-clock me-1"></i><%= booking.checkOutTime %></small>
          <% } %>
        </div>
        <div class="col-6 col-md-3">
          <small class="text-secondary d-block font-monospace">GUESTS</small>
          <span class="fw-bold fs-6 text-dark"><%= booking.guests %> <%= booking.guests === 1 ? 'Guest' : 'Guests' %></span>
        </div>
        <div class="col-6 col-md-3">
          <small class="text-secondary d-block font-monospace">DURATION</small>
          <span class="fw-bold fs-6 text-dark"><%= booking.numberOfNights || nights %> <%= (booking.numberOfNights || nights) === 1 ? 'Night' : 'Nights' %></span>
        </div>
      </div>

      <!-- Price Breakdown Summary -->
      <div class="border-top pt-4 mb-4">
        <h6 class="fw-bold mb-3 text-dark text-uppercase small" style="letter-spacing: 0.04em;">Invoice Summary</h6>
        <div class="d-flex justify-content-between text-secondary small mb-2">
          <span>Base Price (&#8377;<%= displayPricePerNight.toLocaleString("en-IN") %> &times; <%= booking.numberOfNights || nights %> <%= (booking.numberOfNights || nights) === 1 ? 'night' : 'nights' %>):</span>
          <span class="fw-semibold text-dark">&#8377;<%= displayBasePrice.toLocaleString("en-IN") %></span>
        </div>
        <div class="d-flex justify-content-between text-secondary small mb-2">
          <span>GST (<%= booking.taxRate != null ? booking.taxRate : 5 %>%):</span>
          <span class="fw-semibold text-dark">&#8377;<%= displayTaxAmount.toLocaleString("en-IN") %></span>
        </div>
        <hr class="my-2">
        <div class="d-flex justify-content-between align-items-center fw-bold fs-5">
          <span class="text-dark">Total Price:</span>
          <span class="text-danger">&#8377;<%= displayTotalPrice.toLocaleString("en-IN") %></span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="d-flex gap-2 flex-wrap align-items-center pt-2 border-top">
        <% if (booking.listing) { %>
          <a href="/listings/<%= booking.listing._id %>" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill">
            <i class="fa-regular fa-eye me-1"></i>View Listing
          </a>
        <% } %>
        <a href="/bookings" class="wl-btn wl-btn-dark wl-btn-sm wl-btn-pill add-btn">
          <i class="fa-solid fa-list me-1"></i>My Bookings
        </a>

        <% if (booking.status !== "CANCELLED" && (booking.paymentStatus === "PENDING" || !booking.paymentStatus)) { %>
          <a href="/bookings/<%= booking._id %>/payment" class="wl-btn wl-btn-primary wl-btn-sm wl-btn-pill fw-bold">
            <i class="fa-solid fa-credit-card me-1"></i>Proceed to Payment
          </a>
        <% } else if (booking.paymentStatus === "PAID") { %>
          <a href="/bookings/<%= booking._id %>/payment" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill text-success border-success">
            <i class="fa-solid fa-receipt me-1"></i>View Payment Receipt
          </a>
          <% if (booking.status !== "COMPLETED" && booking.status !== "CANCELLED") { %>
            <form method="POST" action="/bookings/<%= booking._id %>/refund" class="m-0" data-confirm="Are you sure you want to request a full refund of ₹<%= displayTotalPrice.toLocaleString('en-IN') %> for this reservation?">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill text-warning border-warning" title="Request Refund">
                <i class="fa-solid fa-rotate-left me-1"></i>Request Refund
              </button>
            </form>
          <% } %>
        <% } %>

        <% if (booking.status === "PENDING_PAYMENT" || booking.status === "PENDING" || booking.status === "AWAITING_HOST_APPROVAL" || booking.status === "CONFIRMED") { %>
          <form method="POST" action="/bookings/<%= booking._id %>/cancel" class="ms-auto m-0" data-confirm="Are you sure you want to cancel this booking?">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill text-danger border-danger">
              <i class="fa-solid fa-ban me-1"></i>Cancel Booking
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>
