<% layout("/layouts/boilerplate") %>
<%
  const toRupees = (amt) => (booking && booking.isPaise ? (amt || 0) / 100 : (amt || 0));
  const displayPricePerNight = booking.pricePerNight != null ? toRupees(booking.pricePerNight) : (booking.listing ? booking.listing.price : 0);
  const displayBasePrice = booking.basePrice != null ? toRupees(booking.basePrice) : toRupees(booking.totalPrice);
  const displayTaxAmount = toRupees(booking.taxAmount);
  const displayTotalPrice = toRupees(booking.totalPrice);
%>

<div class="row justify-content-center mt-4 mb-5">
  <div class="col-12 col-md-10 col-lg-8">
    <div class="wl-form-card p-4 p-md-5">
      <!-- Status Header -->
      <div class="text-center mb-4 pb-4 border-bottom">
        <% if (booking.status === 'CONFIRMED') { %>
          <div class="mb-2">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 64px; height: 64px; background-color: var(--wl-success-subtle); color: var(--wl-success);">
              <i class="fa-solid fa-circle-check fs-2"></i>
            </span>
          </div>
          <h2 class="fw-bold mb-1 text-dark">Booking Confirmed</h2>
          <p class="text-success fw-semibold mb-3 small">
            <i class="fa-solid fa-check me-1"></i>Your stay has been confirmed by the host!
          </p>
        <% } else if (booking.status === 'AWAITING_HOST_APPROVAL' || (booking.status === 'PENDING' && booking.paymentStatus === 'PAID')) { %>
          <div class="mb-2">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 64px; height: 64px; background-color: var(--wl-primary-subtle); color: var(--wl-primary);">
              <i class="fa-solid fa-hourglass-half fs-2"></i>
            </span>
          </div>
          <h2 class="fw-bold mb-1 text-dark">Payment Received — Awaiting Host Approval</h2>
          <p class="text-secondary fw-semibold mb-3 small">
            <i class="fa-solid fa-clock me-1"></i>Payment captured via escrow. The host is reviewing your reservation.
          </p>
        <% } else if (booking.status === 'PENDING_PAYMENT' || (booking.status === 'PENDING' && booking.paymentStatus !== 'PAID')) { %>
          <div class="mb-2">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 64px; height: 64px; background-color: var(--wl-warning-subtle); color: var(--wl-warning);">
              <i class="fa-solid fa-clock fs-2"></i>
            </span>
          </div>
          <!-- EXACT REQUIRED TEST HEADER STRING -->
          <h2 class="fw-bold mb-1 text-dark">Booking Pending (Awaiting Payment)</h2>
          <p class="text-secondary fw-semibold mb-3 small">
            <i class="fa-regular fa-clock me-1 text-warning"></i>Please complete payment within 15 minutes to secure your reservation.
          </p>
        <% } else if (booking.status === 'COMPLETED') { %>
          <div class="mb-2">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 64px; height: 64px; background-color: var(--wl-surface-subtle); color: var(--wl-secondary);">
              <i class="fa-solid fa-flag-checkered fs-2"></i>
            </span>
          </div>
          <h2 class="fw-bold mb-1 text-dark">Trip Completed</h2>
          <p class="text-secondary fw-semibold mb-3 small">
            <i class="fa-solid fa-circle-check me-1"></i>We hope you enjoyed your time with WanderLust!
          </p>
          <% if (booking.listing) { %>
            <div class="mt-2 mb-3">
              <a href="/listings/<%= booking.listing._id || booking.listing %>#reviews" class="wl-btn wl-btn-outline wl-btn-sm">
                <i class="fa-solid fa-star text-warning me-1"></i>Review Your Stay
              </a>
            </div>
          <% } %>
        <% } else if (booking.status === 'CANCELLED') { %>
          <div class="mb-2">
            <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 64px; height: 64px; background-color: var(--wl-danger-subtle); color: var(--wl-danger);">
              <i class="fa-solid fa-circle-xmark fs-2"></i>
            </span>
          </div>
          <h2 class="fw-bold mb-1 text-dark">Booking Cancelled</h2>
          <p class="text-danger fw-semibold mb-3 small">
            <i class="fa-solid fa-ban me-1"></i>This reservation has been cancelled.
          </p>
        <% } %>

        <div class="d-flex justify-content-center gap-2 flex-wrap">
          <span class="badge <%= booking.status === 'CONFIRMED' ? 'bg-success' : (booking.status === 'CANCELLED' ? 'bg-danger' : (booking.status === 'COMPLETED' ? 'bg-secondary' : (booking.status === 'AWAITING_HOST_APPROVAL' ? 'bg-primary text-white' : 'bg-warning text-dark'))) %> px-3 py-2 fs-6">
            Status: <%= (booking.status === 'AWAITING_HOST_APPROVAL') ? 'Awaiting Host Approval' : ((booking.status === 'PENDING_PAYMENT') ? 'Awaiting Payment' : booking.status) %>
          </span>
          <% if (booking.paymentStatus === "PAID") { %>
            <span class="badge bg-success px-3 py-2 fs-6">
              <i class="fa-solid fa-circle-check me-1"></i>Payment: PAID
            </span>
          <% } else if (booking.paymentStatus === "REFUND_PENDING") { %>
            <span class="badge bg-warning text-dark px-3 py-2 fs-6">
              <i class="fa-solid fa-spinner fa-spin me-1"></i>Payment: REFUND PENDING
            </span>
          <% } else if (booking.paymentStatus === "FAILED") { %>
            <span class="badge bg-danger px-3 py-2 fs-6">
              <i class="fa-solid fa-circle-xmark me-1"></i>Payment: FAILED
            </span>
          <% } else if (booking.paymentStatus === "REFUNDED") { %>
            <span class="badge bg-secondary px-3 py-2 fs-6">
              <i class="fa-solid fa-rotate-left me-1"></i>Payment: REFUNDED
            </span>
          <% } else { %>
            <span class="badge bg-warning text-dark px-3 py-2 fs-6">
              <i class="fa-solid fa-hourglass-half me-1"></i>Payment: PENDING
            </span>
          <% } %>
        </div>
      </div>

      <!-- Property Summary Card -->
      <div class="card mb-4 border rounded-3 bg-light p-3">
        <div class="row g-3 align-items-center">
          <% if (booking.listing && booking.listing.image && booking.listing.image.url) { %>
            <div class="col-12 col-sm-4">
              <img
                src="<%= booking.listing.image.url %>"
                class="img-fluid rounded-3 w-100 object-fit-cover"
                style="height: 130px; object-fit: cover;"
                alt="<%= booking.listing.title %>"
              />
            </div>
          <% } %>
          <div class="col-12 <%= (booking.listing && booking.listing.image && booking.listing.image.url) ? 'col-sm-8' : 'col-12' %>">
            <small class="text-uppercase fw-bold text-muted" style="font-size: 0.75rem; letter-spacing: 0.05em;">Reserved Stay</small>
            <h4 class="fw-bold mb-1 fs-5"><%= booking.listing ? booking.listing.title : "Listing Unavailable" %></h4>
            <p class="text-muted mb-2 small">
              <i class="fa-solid fa-location-dot me-1 text-danger"></i>
              <span><%= booking.listing ? booking.listing.location : "N/A" %><% if (booking.listing && booking.listing.country) { %>, <%= booking.listing.country %><% } %></span>
            </p>
            <p class="mb-0 small fw-semibold">
              <span class="text-muted">Rate:</span> &#8377;<%= displayPricePerNight.toLocaleString("en-IN") %> / night
            </p>
          </div>
        </div>
      </div>

      <!-- Reservation Matrix -->
      <h5 class="fw-bold mb-3 fs-6 text-uppercase text-secondary">Reservation Details</h5>
      <div class="row g-3 mb-4 bg-light rounded-3 p-3 mx-0">
        <div class="col-6 col-md-3">
          <small class="text-muted d-block small">Check-in</small>
          <span class="fw-bold fs-6"><%= new Date(booking.checkInDate || booking.checkIn).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) %></span>
          <% if (booking.checkInTime) { %>
            <small class="text-muted d-block"><i class="fa-regular fa-clock me-1"></i><%= booking.checkInTime %></small>
          <% } %>
        </div>
        <div class="col-6 col-md-3">
          <small class="text-muted d-block small">Check-out</small>
          <span class="fw-bold fs-6"><%= new Date(booking.checkOutDate || booking.checkOut).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) %></span>
          <% if (booking.checkOutTime) { %>
            <small class="text-muted d-block"><i class="fa-regular fa-clock me-1"></i><%= booking.checkOutTime %></small>
          <% } %>
        </div>
        <div class="col-6 col-md-3">
          <small class="text-muted d-block small">Guests</small>
          <span class="fw-bold fs-6"><%= booking.guests %> <%= booking.guests === 1 ? 'guest' : 'guests' %></span>
        </div>
        <div class="col-6 col-md-3">
          <small class="text-muted d-block small">Length</small>
          <span class="fw-bold fs-6"><%= booking.numberOfNights || nights %> <%= (booking.numberOfNights || nights) === 1 ? 'night' : 'nights' %></span>
        </div>
      </div>

      <!-- Price Breakdown -->
      <div class="border-top pt-3 mb-4">
        <h5 class="fw-bold mb-3 fs-6 text-uppercase text-secondary">Invoice Summary</h5>
        <div class="d-flex justify-content-between text-muted mb-2 small">
          <span>Base Nightly Rate:</span>
          <span>&#8377;<%= displayPricePerNight.toLocaleString("en-IN") %></span>
        </div>
        <div class="d-flex justify-content-between text-muted mb-2 small">
          <span>Stays Subtotal (<%= displayPricePerNight.toLocaleString("en-IN") %> &times; <%= booking.numberOfNights || nights %> <%= (booking.numberOfNights || nights) === 1 ? 'night' : 'nights' %>):</span>
          <span>&#8377;<%= displayBasePrice.toLocaleString("en-IN") %></span>
        </div>
        <div class="d-flex justify-content-between text-muted mb-2 small">
          <span>GST (<%= booking.taxRate != null ? booking.taxRate : 5 %>%):</span>
          <span>&#8377;<%= displayTaxAmount.toLocaleString("en-IN") %></span>
        </div>
        <hr class="my-2 text-muted">
        <div class="d-flex justify-content-between align-items-baseline fw-bold fs-5">
          <span>Total:</span>
          <span style="color: var(--wl-primary);">&#8377;<%= displayTotalPrice.toLocaleString("en-IN") %></span>
        </div>
      </div>

      <!-- Navigation & Action Buttons -->
      <div class="d-flex gap-2 mt-2 flex-wrap align-items-center">
        <% if (booking.listing) { %>
          <a href="/listings/<%= booking.listing._id %>" class="wl-btn wl-btn-outline wl-btn-sm">
            View Listing
          </a>
        <% } %>
        <a href="/bookings" class="wl-btn wl-btn-outline wl-btn-sm add-btn">
          My Bookings
        </a>

        <% if (booking.status !== "CANCELLED" && (booking.paymentStatus === "PENDING" || !booking.paymentStatus)) { %>
          <a href="/bookings/<%= booking._id %>/payment" class="wl-btn wl-btn-accent wl-btn-sm add-btn text-white">
            <i class="fa-solid fa-credit-card me-1"></i>Proceed to Payment
          </a>
        <% } else if (booking.paymentStatus === "PAID") { %>
          <a href="/bookings/<%= booking._id %>/payment" class="wl-btn wl-btn-outline wl-btn-sm">
            <i class="fa-solid fa-receipt me-1"></i>View Receipt
          </a>
          <% if (booking.status !== "COMPLETED" && booking.status !== "CANCELLED") { %>
            <form method="POST" action="/bookings/<%= booking._id %>/refund" class="m-0" data-confirm="Are you sure you want to request a full refund of ₹<%= displayTotalPrice.toLocaleString('en-IN') %> for this reservation?">
              <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
              <button type="submit" class="wl-btn wl-btn-outline text-danger border-danger-subtle wl-btn-sm" title="Request Refund">
                <i class="fa-solid fa-rotate-left me-1"></i>Request Refund
              </button>
            </form>
          <% } %>
        <% } %>

        <% if (booking.status === "PENDING_PAYMENT" || booking.status === "PENDING" || booking.status === "AWAITING_HOST_APPROVAL" || booking.status === "CONFIRMED") { %>
          <form method="POST" action="/bookings/<%= booking._id %>/cancel" class="ms-auto m-0" data-confirm="Are you sure you want to cancel this booking?">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="wl-btn wl-btn-outline text-danger border-danger-subtle wl-btn-sm">
              <i class="fa-solid fa-ban me-1"></i>Cancel Booking
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</div>
