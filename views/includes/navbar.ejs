          <% if (currentUser.role === "USER") { %>
            <a class="wl-nav-link" href="/become-host">
              <i class="fa-solid fa-house-chimney-user me-1" style="color: #cd8032;"></i>Become a Host
            </a>
          <% } else if (currentUser.role === "HOST") { %>
            <a class="wl-btn wl-btn-primary wl-btn-sm wl-btn-pill me-lg-1" href="/listings/new">
              <i class="fa-solid fa-plus me-1"></i>Add Listing
            </a>
          <% } %>

          <a class="wl-nav-link" href="/wishlist" title="Wishlist" id="navbarWishlistLink">
            <i class="fa-regular fa-heart me-1" id="navbarWishlistIcon" style="color: #cd8032; display: inline-block;"></i>Wishlist
          </a>
          <a class="wl-nav-link" href="/bookings" title="My Bookings">
            <i class="fa-regular fa-calendar-check me-1" style="color: #b78727;"></i>Trips
          </a>

          <!-- User Profile Dropdown -->
          <div class="nav-item dropdown ms-lg-2 mt-2 mt-lg-0">
            <a class="wl-user-pill dropdown-toggle" href="#" id="navbarUserDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <div class="wl-avatar-circle">
                <%= currentUser.username ? currentUser.username.charAt(0).toUpperCase() : 'U' %>
              </div>
              <span class="d-none d-xl-inline fw-semibold small"><%= currentUser.username %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end wl-user-dropdown-menu border-0 mt-2" aria-labelledby="navbarUserDropdown">
              <!-- User Header Card -->
              <li class="wl-dropdown-header-card">
                <div class="wl-dropdown-header-avatar">
                  <%= currentUser.username ? currentUser.username.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div class="overflow-hidden">
                  <span class="d-block fw-bold text-dark text-truncate" style="font-size: 0.95rem;"><%= currentUser.username %></span>
                  <span class="d-block text-muted small text-truncate" style="font-size: 0.76rem;"><%= currentUser.email || '' %></span>
                  <% if (currentUser.role === 'HOST') { %>
                    <span class="badge rounded-pill mt-1" style="background-color: #FAF3E0; color: #CD8032; border: 1px solid #E8DDD1; font-size: 0.68rem; font-weight: 700;">
                      <i class="fa-solid fa-crown me-1" style="color: #D7B137;"></i>Host Account
                    </span>
                  <% } else { %>
                    <span class="badge rounded-pill mt-1" style="background-color: #FAF5DC; color: #B78727; border: 1px solid #E8DDD1; font-size: 0.68rem; font-weight: 700;">
                      <i class="fa-solid fa-compass me-1"></i>Traveler Account
                    </span>
                  <% } %>
                </div>
              </li>

              <!-- Menu Items with Micro-Interactions -->
              <li>
                <a class="wl-dropdown-item" href="/dashboard">
                  <span class="wl-dropdown-item-icon" style="background-color: #FAF3E0; color: #CD8032;">
                    <i class="fa-solid fa-gauge-high"></i>
                  </span>
                  <span>Traveler Dashboard</span>
                </a>
              </li>

              <% if (currentUser.role === "HOST") { %>
                <li>
                  <a class="wl-dropdown-item" href="/host/dashboard">
                    <span class="wl-dropdown-item-icon" style="background-color: #FAF5DC; color: #B78727;">
                      <i class="fa-solid fa-hotel"></i>
                    </span>
                    <span>Host Hub</span>
                  </a>
                </li>
                <li>
                  <a class="wl-dropdown-item" href="/host/listings">
                    <span class="wl-dropdown-item-icon" style="background-color: #F2EAE4; color: #4A2417;">
                      <i class="fa-solid fa-house-chimney"></i>
                    </span>
                    <span>My Listings</span>
                  </a>
                </li>
                <li>
                  <a class="wl-dropdown-item" href="/host/bookings">
                    <span class="wl-dropdown-item-icon" style="background-color: #FEF9E7; color: #D7B137;">
                      <i class="fa-solid fa-calendar-check"></i>
                    </span>
                    <span>Bookings Received</span>
                  </a>
                </li>
              <% } %>

              <li>
                <a class="wl-dropdown-item" href="/profile/edit">
                  <span class="wl-dropdown-item-icon" style="background-color: #F5EFE6; color: #785949;">
                    <i class="fa-solid fa-user-pen"></i>
                  </span>
                  <span>Edit Profile</span>
                </a>
              </li>

              <li><hr class="my-2" style="border-color: var(--wl-border); opacity: 0.8;"></li>

              <li>
                <a class="wl-dropdown-item wl-dropdown-item-logout" href="/logout">
                  <span class="wl-dropdown-item-icon" style="background-color: #FDF2F0; color: #B33927;">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                  </span>
                  <span>Log Out</span>
                </a>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>

<script>
  (() => {
    const searchInput = document.querySelector(".search-inp");
    if (!searchInput) return;

    let isClearing = false;
    const handleClear = () => {
      if (isClearing) return;
      if (searchInput.value.trim() === "") {
        const urlParams = new URLSearchParams(window.location.search);
        const isSearchActive = window.location.pathname.includes("/search") || urlParams.has("q");
        if (isSearchActive) {
          isClearing = true;
          const hiddenCategoryInput = document.querySelector('form[action="/listings/search"] input[name="category"]');
          const category = urlParams.get("category") || (hiddenCategoryInput ? hiddenCategoryInput.value : "");
          if (category && category.trim()) {
            window.location.href = `/listings?category=${encodeURIComponent(category.trim())}`;
          } else {
            window.location.href = "/listings";
          }
        }
      }
    };

    searchInput.addEventListener("input", handleClear);
    searchInput.addEventListener("search", handleClear);
  })();
</script>