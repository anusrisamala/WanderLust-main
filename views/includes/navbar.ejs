          <i class="fa-solid fa-magnifying-glass text-muted fs-6 ms-1"></i>
          <input
            class="wl-search-input search-inp"
            type="search"
            name="q"
            placeholder="Search destinations, villas, cities..."
            value="<%= typeof searchQuery !== 'undefined' && searchQuery ? searchQuery : '' %>"
            autocomplete="off"
          />
          <button class="wl-search-btn search-btn" type="submit">
            Search
          </button>
        </form>
      </div>

      <!-- Action Navigation -->
      <div class="navbar-nav ms-auto align-items-lg-center gap-1 gap-lg-2">
        <a class="wl-nav-link" href="/listings">
          <i class="fa-regular fa-compass me-1" style="color: #cd8032;"></i>Explore
        </a>

        <% const currentUser = (typeof currUser !== "undefined") ? currUser : null; %>
        <% if (!currentUser) { %>
          <a class="wl-nav-link" href="/listings/new">
            Host your home
          </a>
          <div class="d-flex align-items-center gap-2 ms-lg-2 mt-2 mt-lg-0">
            <a class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill" href="/login">
              Log In
            </a>
            <a class="wl-btn wl-btn-primary wl-btn-sm wl-btn-pill" href="/signup">
              Sign Up
            </a>
