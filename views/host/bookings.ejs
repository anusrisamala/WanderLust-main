<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-12">
    <!-- Breadcrumb / Back to Host Dashboard -->
    <div class="mb-3">
      <a href="/host/dashboard" class="text-decoration-none text-muted small fw-medium">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Host Dashboard
      </a>
    </div>

    <!-- Header & Action Bar -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0">Bookings Received</h2>
            <span class="badge bg-primary fs-6 align-middle">
              <%= statusCounts.ALL %> Total
            </span>
          </div>
          <p class="text-muted small mb-0">
            Monitor, review, and track all guest reservations placed on your hosted properties.
          </p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/host/dashboard" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill">
            <i class="fa-solid fa-gauge-high me-1"></i>Host Dashboard
          </a>
          <a href="/host/listings" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill">
            <i class="fa-solid fa-house-chimney me-1"></i>My Listings
          </a>
          <a href="/listings/new" class="wl-btn wl-btn-primary wl-btn-sm wl-btn-pill add-btn">
            <i class="fa-solid fa-plus me-1"></i>Add Listing
          </a>
        </div>
      </div>
    </div>

    <!-- Filter Pills / Tabs -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex flex-wrap gap-2 align-items-center">
          <span class="fw-bold small text-uppercase text-secondary me-1">
            <i class="fa-solid fa-filter me-1 text-danger"></i>Filter By:
          </span>
          <a
            href="/host/bookings"
            class="btn btn-sm <%= currentStatus === 'ALL' ? 'btn-dark fw-bold' : 'btn-outline-secondary' %> rounded-pill px-3"
          >
            All <span class="badge <%= currentStatus === 'ALL' ? 'bg-light text-dark' : 'bg-secondary' %> ms-1"><%= statusCounts.ALL %></span>
          </a>
          <a
            href="/host/bookings?status=AWAITING_HOST_APPROVAL"
            class="btn btn-sm <%= currentStatus === 'AWAITING_HOST_APPROVAL' ? 'btn-primary text-white fw-bold' : 'btn-outline-secondary' %> rounded-pill px-3"
          >
            <i class="fa-solid fa-clock-rotate-left me-1"></i>Pending Approval
            <span class="badge <%= currentStatus === 'AWAITING_HOST_APPROVAL' ? 'bg-light text-dark' : 'bg-secondary' %> ms-1"><%= statusCounts.AWAITING_HOST_APPROVAL || 0 %></span>
          </a>
          <a
            href="/host/bookings?status=CONFIRMED"
            class="btn btn-sm <%= currentStatus === 'CONFIRMED' ? 'btn-success text-white fw-bold' : 'btn-outline-secondary' %> rounded-pill px-3"
          >
            <i class="fa-solid fa-circle-check me-1"></i>Confirmed
            <span class="badge <%= currentStatus === 'CONFIRMED' ? 'bg-light text-dark' : 'bg-secondary' %> ms-1"><%= statusCounts.CONFIRMED %></span>
          </a>
          <a
            href="/host/bookings?status=PENDING_PAYMENT"
            class="btn btn-sm <%= currentStatus === 'PENDING_PAYMENT' ? 'btn-warning text-dark fw-bold' : 'btn-outline-secondary' %> rounded-pill px-3"
          >
            <i class="fa-regular fa-clock me-1"></i>Awaiting Payment
            <span class="badge <%= currentStatus === 'PENDING_PAYMENT' ? 'bg-dark text-white' : 'bg-secondary' %> ms-1"><%= statusCounts.PENDING_PAYMENT || 0 %></span>
          </a>
          <a
            href="/host/bookings?status=COMPLETED"
            class="btn btn-sm <%= currentStatus === 'COMPLETED' ? 'btn-info text-dark fw-bold' : 'btn-outline-secondary' %> rounded-pill px-3"
          >
            <i class="fa-solid fa-flag-checkered me-1"></i>Completed
            <span class="badge <%= currentStatus === 'COMPLETED' ? 'bg-dark text-white' : 'bg-secondary' %> ms-1"><%= statusCounts.COMPLETED %></span>
          </a>
          <a
            href="/host/bookings?status=CANCELLED"
            class="btn btn-sm <%= currentStatus === 'CANCELLED' ? 'btn-danger text-white fw-bold' : 'btn-outline-secondary' %> rounded-pill px-3"
          >
            <i class="fa-solid fa-ban me-1"></i>Cancelled
            <span class="badge <%= currentStatus === 'CANCELLED' ? 'bg-light text-dark' : 'bg-secondary' %> ms-1"><%= statusCounts.CANCELLED %></span>
          </a>
        </div>
        <div class="text-muted small">
          Showing <strong><%= hostBookings ? hostBookings.length : 0 %></strong> <%= (currentStatus === 'ALL') ? 'total' : currentStatus.toLowerCase() %> <%= hostBookings && hostBookings.length === 1 ? 'booking' : 'bookings' %>
        </div>
      </div>
    </div>

    <!-- Bookings List -->
    <% if (!hostBookings || hostBookings.length === 0) { %>
      <!-- Empty State -->
      <div class="card border shadow-sm rounded-4 p-5 text-center my-4 bg-white">
        <div class="py-5">
          <i class="fa-regular fa-calendar-xmark fa-4x text-muted mb-3 opacity-50"></i>
          <h4 class="fw-bold mb-2">No <%= currentStatus !== 'ALL' ? currentStatus.toLowerCase() + ' ' : '' %>bookings found</h4>
          <p class="text-muted small mb-4" style="max-width: 480px; margin: 0 auto;">
            <% if (currentStatus === 'ALL') { %>
              When travelers book any of your properties, their reservation details, guest information, and pricing breakdown will appear here.
            <% } else { %>
              You currently do not have any bookings with status <strong><%= currentStatus %></strong>.
            <% } %>
          </p>
          <% if (currentStatus !== 'ALL') { %>
            <a href="/host/bookings" class="btn btn-outline-dark fw-semibold px-3 py-2">
              <i class="fa-solid fa-rotate-left me-1"></i>View All Bookings
            </a>
          <% } else { %>
            <a href="/host/listings" class="btn btn-outline-dark fw-semibold px-3 py-2">
              <i class="fa-solid fa-house-chimney me-1"></i>View My Hosted Listings
            </a>
          <% } %>
        </div>
      </div>
    <% } else { %>
      <!-- Booking Cards Stack -->
      <div class="d-flex flex-column gap-3">
        <% for (let booking of hostBookings) { %>
          <div class="card border shadow-sm rounded-4 overflow-hidden bg-white">
            <!-- Card Header: Listing & Status -->
            <div class="card-header bg-light bg-opacity-50 py-3 px-4 border-bottom">
              <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div class="d-flex align-items-center gap-3">
                  <!-- Listing Thumbnail -->
                  <% if (booking.listing && booking.listing.image && booking.listing.image.url) { %>
                    <img
                      src="<%= booking.listing.image.url %>"
                      alt="<%= booking.listing.title %>"
                      class="rounded-3 object-fit-cover shadow-sm"
                      style="width: 54px; height: 54px;"
                    />
                  <% } else { %>
                    <div class="bg-secondary bg-opacity-10 text-secondary rounded-3 d-flex align-items-center justify-content-center" style="width: 54px; height: 54px;">
                      <i class="fa-solid fa-house fa-lg"></i>
                    </div>
                  <% } %>
                  <div>
                    <% if (booking.listing && booking.listing._id) { %>
                      <a href="/listings/<%= booking.listing._id %>" class="text-dark fw-bold fs-6 text-decoration-none hover-underline">
                        <%= booking.listing.title %>
                      </a>
                      <div class="text-muted small">
                        <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                        <%= booking.listing.location %><% if (booking.listing.country) { %>, <%= booking.listing.country %><% } %>
                      </div>
                    <% } else { %>
                      <span class="text-muted fw-bold">Listing Removed</span>
                    <% } %>
                  </div>
                </div>

                <!-- Status Badge & Date -->
                <div class="d-flex align-items-center gap-3">
                  <% if (booking.status === "AWAITING_HOST_APPROVAL" || (booking.status === "PENDING" && booking.paymentStatus === "PAID")) { %>
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 fw-semibold">
                      <i class="fa-solid fa-clock-rotate-left me-1"></i>Awaiting Approval
                    </span>
                  <% } else if (booking.status === "PENDING_PAYMENT" || (booking.status === "PENDING" && booking.paymentStatus !== "PAID")) { %>
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-2 fw-semibold">
                      <i class="fa-regular fa-clock me-1"></i>Awaiting Payment
                    </span>
                  <% } else if (booking.status === "CONFIRMED") { %>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 fw-semibold">
                      <i class="fa-solid fa-circle-check me-1"></i>Confirmed
                    </span>
                  <% } else if (booking.status === "CANCELLED") { %>
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 fw-semibold">
                      <i class="fa-solid fa-ban me-1"></i>Cancelled
                    </span>
                  <% } else if (booking.status === "COMPLETED") { %>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 fw-semibold">
                      <i class="fa-solid fa-flag-checkered me-1"></i>Completed
                    </span>
                  <% } else { %>
                    <span class="badge bg-light text-dark border px-3 py-2">
                      <%= booking.status %>
                    </span>
                  <% } %>

                  <% if (booking.paymentStatus === "PAID") { %>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 fw-semibold small">
                      <i class="fa-solid fa-receipt me-1"></i>Paid
                    </span>
                  <% } else if (booking.paymentStatus === "REFUNDED") { %>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-2 py-1 fw-semibold small">
                      <i class="fa-solid fa-rotate-left me-1"></i>Refunded
                    </span>
                  <% } else if (booking.paymentStatus === "FAILED") { %>
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1 fw-semibold small">
                      <i class="fa-solid fa-circle-xmark me-1"></i>Payment Failed
                    </span>
                  <% } else { %>
                    <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 px-2 py-1 fw-semibold small">
                      <i class="fa-solid fa-hourglass-half me-1"></i>Unpaid
                    </span>
                  <% } %>

                  <span class="text-muted small" title="Booking ID: <%= booking._id %>">
                    Booked on <%= booking.createdAt ? new Date(booking.createdAt).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "N/A" %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Card Body: Stay & Guest Details -->
            <div class="card-body p-4">
              <div class="row g-3">
                <!-- Guest Info -->
                <div class="col-12 col-md-3 border-end-md">
                  <span class="text-muted small text-uppercase fw-semibold d-block mb-1">
                    <i class="fa-solid fa-user me-1 text-primary"></i>Guest
                  </span>
                  <div class="fw-bold text-dark fs-6">
                    <%= booking.user ? booking.user.username : 'Anonymous Guest' %>
                  </div>
                  <% if (booking.user && booking.user.email) { %>
                    <div class="text-muted small text-truncate" title="<%= booking.user.email %>">
                      <i class="fa-solid fa-envelope me-1 text-secondary"></i><%= booking.user.email %>
                    </div>
                  <% } %>
                </div>

                <!-- Check-in Details -->
                <div class="col-6 col-md-3 border-end-md">
                  <span class="text-muted small text-uppercase fw-semibold d-block mb-1">
                    <i class="fa-regular fa-calendar me-1 text-success"></i>Check-In
                  </span>
                  <div class="fw-bold text-dark">
                    <%= booking.checkInDate ? new Date(booking.checkInDate).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", year: "numeric" }) : "N/A" %>
                  </div>
                  <div class="text-muted small">
                    <i class="fa-regular fa-clock me-1"></i><%= booking.checkInTime || "N/A" %>
                  </div>
                </div>

                <!-- Check-out Details -->
                <div class="col-6 col-md-3 border-end-md">
                  <span class="text-muted small text-uppercase fw-semibold d-block mb-1">
                    <i class="fa-regular fa-calendar-check me-1 text-danger"></i>Check-Out
                  </span>
                  <div class="fw-bold text-dark">
                    <%= booking.checkOutDate ? new Date(booking.checkOutDate).toLocaleDateString("en-US", { weekday: "short", month: "short", day: "numeric", year: "numeric" }) : "N/A" %>
                  </div>
                  <div class="text-muted small">
                    <i class="fa-regular fa-clock me-1"></i><%= booking.checkOutTime || "N/A" %>
                  </div>
                </div>

                <!-- Guests & Duration -->
                <div class="col-12 col-md-3">
                  <span class="text-muted small text-uppercase fw-semibold d-block mb-1">
                    <i class="fa-solid fa-people-group me-1 text-info"></i>Party Size & Nights
                  </span>
                  <div class="fw-bold text-dark">
                    <%= booking.guests || 1 %> <%= (booking.guests === 1) ? 'Guest' : 'Guests' %>
                  </div>
                  <div class="text-muted small">
                    <%= booking.numberOfNights || 1 %> <%= (booking.numberOfNights === 1) ? 'Night' : 'Nights' %> Stay
                  </div>
                </div>
              </div>
            </div>

            <!-- Card Footer: Price Breakdown -->
            <div class="card-footer bg-light bg-opacity-25 px-4 py-3 border-top">
              <%
                const toRupees = (amt) => (booking && booking.isPaise ? (amt || 0) / 100 : (amt || 0));
                const displayPricePerNight = toRupees(booking.pricePerNight);
                const displayBasePrice = toRupees(booking.basePrice);
                const displayTaxAmount = toRupees(booking.taxAmount);
                const displayTotalPrice = toRupees(booking.totalPrice);
              %>
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 small">
                <div class="d-flex flex-wrap gap-3 text-secondary">
                  <span>
                    Rate: <strong class="text-dark">&#8377;<%= displayPricePerNight.toLocaleString("en-IN") %></strong>/night
                  </span>
                  <span>•</span>
                  <span>
                    Base: <strong class="text-dark">&#8377;<%= displayBasePrice.toLocaleString("en-IN") %></strong>
                  </span>
                  <span>•</span>
                  <span>
                    GST (<%= booking.taxRate || 5 %>%): <strong class="text-dark">&#8377;<%= displayTaxAmount.toLocaleString("en-IN") %></strong>
                  </span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <div class="text-end me-2">
                    <span class="text-muted me-1">Total Payout:</span>
                    <span class="fs-5 fw-bold text-success">&#8377;<%= displayTotalPrice.toLocaleString("en-IN") %></span>
                  </div>
                  <% if (booking.status === "AWAITING_HOST_APPROVAL" || (booking.status === "PENDING" && booking.paymentStatus === "PAID")) { %>
                    <form method="POST" action="/host/bookings/<%= booking._id %>/confirm" class="d-inline m-0">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                      <button type="submit" class="btn btn-sm btn-success px-2 py-1 fw-semibold" title="Confirm Booking">
                        <i class="fa-solid fa-check me-1"></i>Confirm
                      </button>
                    </form>
                    <form method="POST" action="/host/bookings/<%= booking._id %>/cancel" class="d-inline m-0" data-confirm="Decline this booking? The guest will be fully refunded.">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1 fw-semibold" title="Decline & Refund">
                        <i class="fa-solid fa-ban me-1"></i>Decline
                      </button>
                    </form>
                  <% } else if (booking.status === "PENDING_PAYMENT" || (booking.status === "PENDING" && booking.paymentStatus !== "PAID")) { %>
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-2 py-1 fw-semibold" title="Awaiting guest payment (15m hold)">
                      <i class="fa-regular fa-clock me-1"></i>Awaiting Payment
                    </span>
                    <form method="POST" action="/host/bookings/<%= booking._id %>/cancel" class="d-inline m-0" data-confirm="Are you sure you want to cancel this unpaid hold?">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1 fw-semibold" title="Cancel Hold">
                        <i class="fa-solid fa-ban me-1"></i>Cancel
                      </button>
                    </form>
                  <% } else if (booking.status === "CONFIRMED") { %>
                    <form method="POST" action="/host/bookings/<%= booking._id %>/complete" class="d-inline m-0" data-confirm="Mark this booking as completed?">
                      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                      <button type="submit" class="btn btn-sm btn-outline-primary px-2 py-1 fw-semibold" title="Mark Completed">
                        <i class="fa-solid fa-flag-checkered me-1"></i>Complete
                      </button>
                    </form>
                  <% } %>
                  <a href="/host/bookings/<%= booking._id %>" class="btn btn-sm btn-outline-dark px-3 py-1 fw-semibold">
                    <i class="fa-solid fa-circle-info me-1"></i>View Details
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
