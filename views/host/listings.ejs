<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-12">
    <!-- Breadcrumb / Back to Host Dashboard -->
    <div class="mb-3">
      <a href="/host/dashboard" class="wl-btn wl-btn-ghost wl-btn-sm">
        <i class="fa-solid fa-arrow-left me-1"></i>Back to Host Dashboard
      </a>
    </div>

    <!-- Header & Action Bar -->
    <div class="card border rounded-3 p-4 mb-4 bg-white shadow-xs">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
          <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0 fs-3">My Hosted Listings</h2>
            <span class="badge bg-secondary fs-6 align-middle">
              <%= hostListings ? hostListings.length : 0 %>
            </span>
          </div>
          <p class="text-muted small mb-0">
            View, edit, archive, or manage the properties you have listed on WanderLust.
          </p>
        </div>
        <div class="d-flex gap-2">
          <a href="/host/dashboard" class="wl-btn wl-btn-outline wl-btn-sm">
            <i class="fa-solid fa-gauge-high me-1"></i>Host Portal
          </a>
          <a href="/listings/new" class="wl-btn wl-btn-primary wl-btn-sm add-btn text-white">
            <i class="fa-solid fa-plus me-1"></i>Add New Listing
          </a>
        </div>
      </div>
    </div>

    <!-- Listings Content -->
    <% if (!hostListings || hostListings.length === 0) { %>
      <!-- Empty State -->
      <div class="wl-form-card p-5 text-center my-4 bg-white mx-auto" style="max-width: 540px;">
        <div class="py-4">
          <i class="fa-solid fa-house-circle-check fa-3x text-muted mb-3 opacity-50"></i>
          <h4 class="fw-bold mb-2">You haven't listed any spaces yet</h4>
          <p class="text-muted small mb-4">
            Welcome travelers from around the globe. Upload photos, set your pricing, and publish your first listing.
          </p>
          <a href="/listings/new" class="wl-btn wl-btn-primary wl-btn-lg add-btn text-white">
            <i class="fa-solid fa-plus me-2"></i>Create First Listing
          </a>
        </div>
      </div>
    <% } else { %>
      <!-- Listings Grid -->
      <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
        <% for (let listing of hostListings) { %>
          <div class="col">
            <div class="card listing-card wl-listing-card h-100 bg-white">
              <!-- Media -->
              <div class="wl-card-media">
                <a href="/listings/<%= listing._id %>" class="listing-link">
                  <img
                    src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e' %>"
                    class="card-img-top"
                    alt="<%= listing.title %>"
                  />
                </a>
                <% if (listing.category) { %>
                  <span class="wl-card-badge">
                    <%= listing.category %>
                  </span>
                <% } %>
                <% if (listing.isActive === false) { %>
                  <span class="position-absolute top-0 end-0 m-2 badge bg-secondary px-2 py-1 small shadow-xs">
                    <i class="fa-solid fa-box-archive me-1"></i>Archived
                  </span>
                <% } %>
              </div>

              <!-- Body -->
              <div class="wl-card-content">
                <div class="wl-card-header-row">
                  <h3 class="wl-card-title"><%= listing.title %></h3>
                </div>
                <div class="wl-card-location">
                  <i class="fa-solid fa-location-dot me-1 small" style="color: var(--wl-secondary);"></i>
                  <%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %>
                </div>
                <div class="wl-card-pricing">
                  <div>
                    <span class="wl-card-rate">&#8377;<%= (listing.price || 0).toLocaleString("en-IN") %></span>
                    <span class="wl-card-rate-period">/ night</span>
                  </div>
                </div>

                <!-- Host Card Actions -->
                <div class="d-flex gap-2 pt-3 mt-3 border-top align-items-center">
                  <a href="/listings/<%= listing._id %>" class="wl-btn wl-btn-outline wl-btn-sm flex-grow-1">
                    View
                  </a>
                  <a href="/listings/<%= listing._id %>/edit" class="wl-btn wl-btn-outline wl-btn-sm edit-btn">
                    Edit
                  </a>
                  <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline m-0" data-confirm="Archive this listing? It will be hidden from public search, but all bookings, history, and reviews will be safely preserved.">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <button type="submit" class="wl-btn wl-btn-outline text-danger border-danger-subtle wl-btn-sm" title="Archive Listing">
                      <i class="fa-solid fa-box-archive"></i>
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
