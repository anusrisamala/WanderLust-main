<% layout("/layouts/boilerplate") %>

<!-- 1. Header / Welcome Banner (Luxury Bronze & Gold Theme matching User Dashboard) -->
<div class="dashboard-animated-section my-4">
  <div class="wl-dashboard-welcome">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
      <div class="d-flex align-items-center gap-3">
        <div class="wl-dashboard-avatar" title="Host Profile">
          <i class="fa-solid fa-crown" style="color: #d7b137;"></i>
        </div>
        <div>
          <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
            <h2 class="fw-bold mb-0 text-dark">
              Welcome, <%= user.username ? user.username : "Host" %>! 👋
            </h2>
            <span class="badge rounded-pill px-2 py-1 fw-semibold small" style="background-color: #FAF3E0; color: #CD8032; border: 1px solid #E8DDD1;">
              Host Portal
            </span>
          </div>
          <div class="d-flex flex-wrap align-items-center gap-2 text-secondary small">
            <% if (user.email) { %>
              <span><i class="fa-solid fa-envelope me-1 text-muted"></i><%= user.email %></span>
              <span>•</span>
            <% } %>
            <span><i class="fa-solid fa-hotel me-1" style="color: #b78727;"></i>Managing <%= counts.totalListings %> <%= counts.totalListings === 1 ? 'property' : 'properties' %></span>
            <span>•</span>
            <span class="text-success"><i class="fa-solid fa-shield-halved me-1"></i>Verified Host</span>
          </div>
        </div>
      </div>

      <!-- Header Actions -->
      <div class="d-flex gap-2 flex-wrap align-items-center">
        <a href="/listings/new" class="wl-btn wl-btn-primary wl-btn-sm wl-btn-pill add-btn">
          <i class="fa-solid fa-plus me-1"></i>Add Listing
        </a>
        <a href="/host/listings" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill">
          <i class="fa-solid fa-house-chimney me-1"></i>My Listings
        </a>
        <a href="/host/bookings" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill">
          <i class="fa-solid fa-calendar-check me-1"></i>Bookings Received
        </a>
        <a href="/dashboard" class="wl-btn wl-btn-ghost wl-btn-sm wl-btn-pill">
          <i class="fa-solid fa-user me-1"></i>Traveler Dashboard
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Pending Bookings Alert Banner (if pending requests exist) -->
<% if (counts.pendingBookings > 0) { %>
  <div class="dashboard-animated-section mb-4">
    <div class="alert rounded-4 p-3 p-md-4 shadow-sm" style="background-color: #FFF9E6; border: 1px solid #D7B137;">
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="p-2 rounded-circle" style="background-color: #FAF3E0; color: #CD8032;">
            <i class="fa-solid fa-bell fa-lg"></i>
          </div>
          <div>
            <h6 class="fw-bold mb-1 text-dark">
              <%= counts.pendingBookings %> <%= counts.pendingBookings === 1 ? 'Booking Request' : 'Booking Requests' %> Pending Host Approval
            </h6>
            <p class="text-secondary small mb-0">
              You have traveler booking requests awaiting your review and confirmation.
            </p>
          </div>
        </div>
        <a href="/host/bookings?status=PENDING" class="wl-btn wl-btn-primary wl-btn-sm wl-btn-pill align-self-md-center">
          Review Pending Requests &rarr;
        </a>
      </div>
    </div>
  </div>
<% } %>

<!-- 2. Host KPI Stat Cards (7 Uniform Proportional Blocks - Bronze & Gold Theme) -->
<div class="dashboard-animated-section mb-4">
  <div class="row row-cols-2 row-cols-md-4 row-cols-xl-7 g-3">
    <!-- 1. Total Listings -->
    <div class="col">
      <a href="#my-listings" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Total Listings</span>
          <div class="wl-kpi-icon-pill" style="background-color: #FAF3E0; color: #CD8032;">
            <i class="fa-solid fa-house-chimney"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.totalListings %></div>
        <div class="wl-kpi-sub">
          <span>Your properties</span>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #CD8032;"></div>
      </a>
    </div>

    <!-- 2. Total Bookings -->
    <div class="col">
      <a href="#received-bookings" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Total Bookings</span>
          <div class="wl-kpi-icon-pill" style="background-color: #FAF5DC; color: #B78727;">
            <i class="fa-solid fa-calendar-check"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.totalBookings %></div>
        <div class="wl-kpi-sub">
          <span>Received stays</span>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #B78727;"></div>
      </a>
    </div>

    <!-- 3. Pending Requests -->
    <div class="col">
      <a href="/host/bookings?status=PENDING" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Pending</span>
          <div class="wl-kpi-icon-pill" style="background-color: #FEF9E7; color: #D7B137;">
            <i class="fa-solid fa-hourglass-half"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.pendingBookings %></div>
        <div class="wl-kpi-sub">
          <% if (counts.pendingBookings === 0) { %>
            <span>No requests</span>
          <% } else { %>
            <span class="fw-semibold" style="color: #D7B137;">Awaiting review</span>
          <% } %>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #D7B137;"></div>
      </a>
    </div>

    <!-- 4. Confirmed Stays -->
    <div class="col">
      <a href="/host/bookings?status=CONFIRMED" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Confirmed</span>
          <div class="wl-kpi-icon-pill" style="background-color: #FFF9E6; color: #B49900;">
            <i class="fa-solid fa-circle-check"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.confirmedBookings %></div>
        <div class="wl-kpi-sub">
          <span>Approved stays</span>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #B49900;"></div>
      </a>
    </div>

    <!-- 5. Upcoming Stays -->
    <div class="col">
      <a href="#received-bookings" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Upcoming</span>
          <div class="wl-kpi-icon-pill" style="background-color: #F2EAE4; color: #4A2417;">
            <i class="fa-solid fa-clock"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.upcomingBookings %></div>
        <div class="wl-kpi-sub">
          <span>Future stays</span>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #4A2417;"></div>
      </a>
    </div>

    <!-- 6. Completed Stays -->
    <div class="col">
      <a href="/host/bookings?status=COMPLETED" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Completed</span>
          <div class="wl-kpi-icon-pill" style="background-color: #FDF5EA; color: #785949;">
            <i class="fa-solid fa-flag-checkered"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.completedBookings %></div>
        <div class="wl-kpi-sub">
          <span>Finished stays</span>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #785949;"></div>
      </a>
    </div>

    <!-- 7. Cancelled Stays -->
    <div class="col">
      <a href="/host/bookings?status=CANCELLED" class="wl-kpi-card">
        <div class="wl-kpi-top">
          <span class="wl-kpi-label">Cancelled</span>
          <div class="wl-kpi-icon-pill" style="background-color: #F7EBE4; color: #854D00;">
            <i class="fa-solid fa-ban"></i>
          </div>
        </div>
        <div class="wl-kpi-number"><%= counts.cancelledBookings %></div>
        <div class="wl-kpi-sub">
          <span>Cancelled</span>
        </div>
        <div class="wl-kpi-accent-bar" style="background-color: #854D00;"></div>
      </a>
    </div>
  </div>
</div>

<!-- 3. Streamlined Quick Actions Bar (Uniform with Traveler Dashboard) -->
<div class="dashboard-animated-section mb-4">
  <div class="wl-quick-actions-bar">
    <div class="d-flex align-items-center gap-2">
      <i class="fa-solid fa-compass" style="color: #cd8032;"></i>
      <span class="small fw-bold text-uppercase text-secondary" style="font-size: 0.72rem; letter-spacing: 0.05em;">Quick Navigation:</span>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <a href="#received-bookings" class="wl-action-chip">
        <i class="fa-regular fa-calendar-check text-primary"></i>
        <span>Recent Bookings</span>
      </a>
      <a href="#my-listings" class="wl-action-chip">
        <i class="fa-solid fa-house-chimney text-success"></i>
        <span>My Listings</span>
      </a>
      <a href="/host/bookings?status=PENDING" class="wl-action-chip">
        <i class="fa-solid fa-hourglass-half" style="color: #D7B137;"></i>
        <span>Pending Requests (<%= counts.pendingBookings %>)</span>
      </a>
      <a href="/listings/new" class="wl-action-chip">
        <i class="fa-solid fa-plus" style="color: #b78727;"></i>
        <span>Add Listing</span>
      </a>
      <a href="/dashboard" class="wl-action-chip">
        <i class="fa-solid fa-user text-secondary"></i>
        <span>Traveler View</span>
      </a>
    </div>
  </div>
</div>

<!-- 4. Recent Bookings Received Section -->
<div id="received-bookings" class="dashboard-animated-section mb-5">
  <div class="col-12">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
      <div>
        <h4 class="fw-bold mb-0 text-dark">
          <i class="fa-solid fa-calendar-check me-2" style="color: #cd8032;"></i>Recent Bookings Received
          <span class="badge rounded-pill ms-1" style="background-color: #FAF3E0; color: #CD8032; border: 1px solid #E8DDD1;"><%= counts.totalBookings %></span>
        </h4>
        <small class="text-secondary">Monitor and manage the latest reservations placed on your hosted listings.</small>
      </div>
      <div>
        <a href="/host/bookings" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill">
          <i class="fa-solid fa-list-check me-1"></i>View All Bookings &rarr;
        </a>
      </div>
    </div>

    <% if (!hostBookings || hostBookings.length === 0) { %>
      <div class="card border shadow-sm rounded-4 p-5 text-center my-3 bg-white">
        <div class="py-4">
          <i class="fa-regular fa-calendar-xmark fa-3x text-muted mb-3 opacity-50"></i>
          <h5 class="fw-bold">You haven't received any bookings yet.</h5>
          <p class="text-muted small mb-0">
            When guests reserve any of your properties, their reservation details and guest information will appear here.
          </p>
        </div>
      </div>
    <% } else { %>
      <div class="card border shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr class="small text-muted text-uppercase">
                <th scope="col" class="ps-4">Listing</th>
                <th scope="col">Guest</th>
                <th scope="col">Check-in</th>
                <th scope="col">Check-out</th>
                <th scope="col">Guests</th>
                <th scope="col">Total</th>
                <th scope="col">Status</th>
                <th scope="col" class="text-end pe-4">Action</th>
              </tr>
            </thead>
            <tbody>
              <% const displayBookings = (typeof recentBookings !== 'undefined' && recentBookings) ? recentBookings : hostBookings.slice(0, 5); %>
              <% for (let booking of displayBookings) { %>
                <tr>
                  <td class="ps-4">
                    <div class="d-flex align-items-center gap-3">
                      <% if (booking.listing && booking.listing.image && booking.listing.image.url) { %>
                        <img
                          src="<%= booking.listing.image.url %>"
                          alt="<%= booking.listing.title %>"
                          class="rounded-3 object-fit-cover shadow-sm"
                          style="width: 50px; height: 50px;"
                        />
                      <% } else { %>
                        <div class="bg-light rounded-3 d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 50px;">
                          <i class="fa-solid fa-house"></i>
                        </div>
                      <% } %>
                      <div>
                        <% if (booking.listing && booking.listing._id) { %>
                          <a href="/listings/<%= booking.listing._id %>" class="text-dark fw-bold text-decoration-none hover-underline">
                            <%= booking.listing.title %>
                          </a>
                          <div class="text-muted small">
                            <i class="fa-solid fa-location-dot me-1 text-danger"></i><%= booking.listing.location %><% if (booking.listing.country) { %>, <%= booking.listing.country %><% } %>
                          </div>
                        <% } else { %>
                          <span class="text-muted fw-bold">Listing Removed</span>
                        <% } %>
                      </div>
                    </div>
                  </td>
                  <td>
                    <div>
                      <strong class="text-dark"><%= booking.user ? booking.user.username : 'Guest' %></strong>
                      <% if (booking.user && booking.user.email) { %>
                        <div class="text-muted small text-truncate" style="max-width: 150px;" title="<%= booking.user.email %>"><%= booking.user.email %></div>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark small">
                      <%= booking.checkInDate ? new Date(booking.checkInDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "N/A" %>
                    </div>
                    <% if (booking.checkInTime) { %>
                      <div class="text-muted small" style="font-size: 0.75rem;">
                        <i class="fa-regular fa-clock me-1"></i><%= booking.checkInTime %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark small">
                      <%= booking.checkOutDate ? new Date(booking.checkOutDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }) : "N/A" %>
                    </div>
                    <% if (booking.checkOutTime) { %>
                      <div class="text-muted small" style="font-size: 0.75rem;">
                        <i class="fa-regular fa-clock me-1"></i><%= booking.checkOutTime %>
                      </div>
                    <% } %>
                  </td>
                  <td>
                    <span class="fw-semibold text-dark"><%= booking.guests || 1 %></span>
                    <span class="text-muted small"><%= (booking.guests === 1) ? 'guest' : 'guests' %></span>
                  </td>
                  <td>
                    <strong class="text-dark">&#8377;<%= (booking.isPaise ? (booking.totalPrice || 0) / 100 : (booking.totalPrice || 0)).toLocaleString("en-IN") %></strong>
                  </td>
                  <td>
                    <% if (booking.status === "AWAITING_HOST_APPROVAL" || (booking.status === "PENDING" && booking.paymentStatus === "PAID")) { %>
                      <span class="badge rounded-pill px-2 py-1 small" style="background-color: #FAF3E0; color: #CD8032; border: 1px solid #E8DDD1;">
                        <i class="fa-solid fa-clock-rotate-left me-1"></i>Awaiting Approval
                      </span>
                    <% } else if (booking.status === "PENDING_PAYMENT" || (booking.status === "PENDING" && booking.paymentStatus !== "PAID")) { %>
                      <span class="badge rounded-pill px-2 py-1 small" style="background-color: #FEF9E7; color: #D7B137; border: 1px solid #F8DFBE;">
                        <i class="fa-regular fa-clock me-1"></i>Awaiting Payment
                      </span>
                    <% } else if (booking.status === "CONFIRMED") { %>
                      <span class="badge rounded-pill px-2 py-1 small" style="background-color: #ECFDF5; color: #059669; border: 1px solid #A7F3D0;">
                        <i class="fa-solid fa-circle-check me-1"></i>Confirmed
                      </span>
                    <% } else if (booking.status === "CANCELLED") { %>
                      <span class="badge rounded-pill px-2 py-1 small" style="background-color: #F7EBE4; color: #854D00; border: 1px solid #E8DDD1;">
                        <i class="fa-solid fa-ban me-1"></i>Cancelled
                      </span>
                    <% } else if (booking.status === "COMPLETED") { %>
                      <span class="badge rounded-pill px-2 py-1 small" style="background-color: #F5EFE6; color: #785949; border: 1px solid #E8DDD1;">
                        <i class="fa-solid fa-flag-checkered me-1"></i>Completed
                      </span>
                    <% } else { %>
                      <span class="badge bg-light text-dark border px-2 py-1 small">
                        <%= booking.status %>
                      </span>
                    <% } %>
                    <div class="mt-1">
                      <% if (booking.paymentStatus === "PAID") { %>
                        <span class="badge rounded-pill px-2 py-1" style="font-size: 0.7rem; background-color: #ECFDF5; color: #059669; border: 1px solid #A7F3D0;"><i class="fa-solid fa-check me-1"></i>Paid</span>
                      <% } else if (booking.paymentStatus === "REFUNDED") { %>
                        <span class="badge rounded-pill px-2 py-1" style="font-size: 0.7rem; background-color: #FAF5DC; color: #B78727; border: 1px solid #E8DDD1;"><i class="fa-solid fa-rotate-left me-1"></i>Refunded</span>
                      <% } else if (booking.paymentStatus === "FAILED") { %>
                        <span class="badge rounded-pill px-2 py-1" style="font-size: 0.7rem; background-color: #F7EBE4; color: #854D00; border: 1px solid #E8DDD1;"><i class="fa-solid fa-xmark me-1"></i>Failed</span>
                      <% } else { %>
                        <span class="badge rounded-pill px-2 py-1" style="font-size: 0.7rem; background-color: #FEF9E7; color: #D7B137; border: 1px solid #F8DFBE;"><i class="fa-solid fa-hourglass-half me-1"></i>Pending</span>
                      <% } %>
                    </div>
                  </td>
                  <td class="text-end pe-4">
                    <a href="/host/bookings/<%= booking._id %>" class="btn btn-sm btn-outline-dark px-3 py-1 fw-semibold rounded-pill" title="View Booking Details">
                      <i class="fa-regular fa-eye me-1"></i>View
                    </a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% if (hostBookings.length > 5) { %>
          <div class="card-footer bg-light bg-opacity-50 text-center py-2 border-top">
            <a href="/host/bookings" class="text-decoration-none small fw-semibold" style="color: #b78727;">
              View all <%= hostBookings.length %> received bookings &rarr;
            </a>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

<hr class="my-5 text-muted">

<!-- 5. My Listings Section (Preview) -->
<div id="my-listings" class="dashboard-animated-section mb-5">
  <div class="col-12">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
      <div>
        <h4 class="fw-bold mb-0 text-dark">
          <i class="fa-solid fa-house-chimney me-2" style="color: #cd8032;"></i>My Hosted Properties
          <span class="badge rounded-pill ms-1" style="background-color: #FAF3E0; color: #CD8032; border: 1px solid #E8DDD1;"><%= counts.totalListings %></span>
        </h4>
        <small class="text-secondary">Manage your hosted properties, update details, or add new accommodations.</small>
      </div>
      <div class="d-flex gap-2">
        <a href="/host/listings" class="wl-btn wl-btn-outline wl-btn-sm wl-btn-pill">
          <i class="fa-solid fa-list me-1"></i>View All Listings
        </a>
        <a href="/listings/new" class="wl-btn wl-btn-primary wl-btn-sm wl-btn-pill add-btn">
          <i class="fa-solid fa-plus me-1"></i>Add Listing
        </a>
      </div>
    </div>

    <% if (!hostListings || hostListings.length === 0) { %>
      <div class="card border shadow-sm rounded-4 p-5 text-center my-3 bg-white" style="border-color: var(--wl-border) !important;">
        <div class="py-4">
          <i class="fa-solid fa-house-circle-check fa-3x mb-3 opacity-50" style="color: #b78727;"></i>
          <h5 class="fw-bold text-dark">You haven't created any listings yet.</h5>
          <p class="text-secondary small mb-3">Start earning by sharing your property with guests across WanderLust.</p>
          <a href="/listings/new" class="wl-btn wl-btn-primary wl-btn-sm wl-btn-pill add-btn px-4 py-2">
            <i class="fa-solid fa-plus me-1"></i>Add Listing
          </a>
        </div>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-3 g-4">
        <% const displayListings = (typeof previewListings !== 'undefined' && previewListings) ? previewListings : hostListings.slice(0, 6); %>
        <% for (let listing of displayListings) { %>
          <div class="col">
            <div class="card h-100 border shadow-sm rounded-4 overflow-hidden bg-white" style="border-color: var(--wl-border) !important;">
              <div class="position-relative">
                <img
                  src="<%= (listing.image && listing.image.url) ? listing.image.url : '/images/default.jpg' %>"
                  class="card-img-top object-fit-cover"
                  style="height: 180px; border-radius: 1rem 1rem 0 0 !important;"
                  alt="<%= listing.title %>"
                />
                <% if (listing.category) { %>
                  <span class="position-absolute top-0 start-0 m-2 badge px-2 py-1 small" style="background-color: rgba(36, 22, 18, 0.82); backdrop-filter: blur(6px); color: #ffffff;">
                    <%= listing.category %>
                  </span>
                <% } %>
              </div>
              <div class="card-body p-3 d-flex flex-column justify-content-between">
                <div>
                  <h6 class="fw-bold mb-1 text-truncate text-dark" title="<%= listing.title %>">
                    <%= listing.title %>
                  </h6>
                  <p class="text-secondary small mb-2 text-truncate">
                    <i class="fa-solid fa-location-dot me-1" style="color: #cd8032;"></i><%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %>
                  </p>
                  <p class="mb-3">
                    <span class="fs-6 fw-bold text-dark">&#8377;<%= (listing.price || 0).toLocaleString("en-IN") %></span>
                    <span class="text-muted small"> / night</span>
                  </p>
                </div>
                <div class="d-flex gap-2 pt-2 border-top">
                  <a href="/listings/<%= listing._id %>" class="wl-btn wl-btn-outline wl-btn-sm flex-grow-1">
                    <i class="fa-regular fa-eye me-1"></i>View
                  </a>
                  <a href="/listings/<%= listing._id %>/edit" class="wl-btn wl-btn-outline wl-btn-sm px-3" title="Edit Listing">
                    <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                  </a>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>

      <% if (hostListings.length > 6) { %>
        <div class="text-center mt-4">
          <a href="/host/listings" class="wl-btn wl-btn-outline px-4 py-2">
            View All <%= hostListings.length %> Hosted Listings &rarr;
          </a>
        </div>
      <% } %>
    <% } %>
  </div>
</div>
