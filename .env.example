# Cloudinary Credentials
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# MongoDB Connection String
ATLASDB_URL=mongodb://127.0.0.1:27017/wanderlust

# Session Secret
SECRET=your_session_secret_key

# Razorpay API Credentials
# Use your Razorpay Dashboard Key ID and Key Secret (Test Mode for development/demos)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Webhook Secret (Configured in Razorpay Webhooks dashboard for production verification)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Local Payment Simulator
# Set to 'true' ONLY in local development to simulate payments/refunds when offline.
# In production and staging (NODE_ENV=production|staging), this is strictly ignored
# and fails safely if Razorpay credentials or API calls fail.
ALLOW_PAYMENT_SIMULATOR=true
# Set to true only for a local demo when you want to bypass Razorpay Checkout
# and exercise the application's complete booking/host/refund workflow.
FORCE_PAYMENT_SIMULATOR=false
NODE_ENV=development
